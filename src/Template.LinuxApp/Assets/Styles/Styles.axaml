<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Template.LinuxApp.Controls"
        xmlns:state="using:Template.LinuxApp.State">

    <Styles.Resources>
        <ControlTheme x:Key="{x:Type controls:DeviceCard}"
                      TargetType="controls:DeviceCard">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Classes="panel">
                        <Grid RowDefinitions="Auto,Auto,Auto"
                              ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="{StaticResource SpacingSmall}">
                            <Border Grid.Row="0" Grid.Column="0"
                                    Width="16" Height="16"
                                    x:DataType="state:DeviceStatus"
                                    DataContext="{TemplateBinding Status}"
                                    Classes="device-state"
                                    Classes.running="{Binding IsRunning, FallbackValue=False}"
                                    Classes.connected="{Binding IsConnected, FallbackValue=False}"
                                    Classes.error="{Binding LastError, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}"
                                    Classes.disabled="{Binding !IsEnabled, FallbackValue=False}" />
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="{TemplateBinding Title}"
                                       Classes="card-title" />
                            <TextBlock Grid.Row="0" Grid.Column="2"
                                       x:DataType="state:DeviceStatus"
                                       DataContext="{TemplateBinding Status}"
                                       Text="{Binding Condition, FallbackValue=''}"
                                       Classes="card-note" />
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="{TemplateBinding Device}"
                                       Classes="card-meta" />
                            <ContentPresenter Grid.Row="1" Grid.Column="2"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                       x:DataType="state:DeviceStatus"
                                       DataContext="{TemplateBinding Status}"
                                       IsVisible="{Binding LastError, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}"
                                       Text="{Binding LastError, FallbackValue=''}"
                                       Classes="card-error" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>

    <!-- Kiosk -->
    <Style Selector="Window.hide-cursor, Window.hide-cursor :is(InputElement)">
        <Setter Property="Cursor" Value="None" />
    </Style>

    <!-- Dialog -->
    <Style Selector="Border.dialog-frame">
        <Setter Property="Background" Value="#80000000" />
    </Style>

    <Style Selector="Border.dialog">
        <Setter Property="Width" Value="384" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSmall}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource SystemRegionBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    </Style>

    <Style Selector="Button.keypad">
        <Setter Property="Width" Value="88" />
        <Setter Property="Height" Value="64" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="24" />
    </Style>

    <Style Selector="TextBlock.dialog-title">
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Toolbar -->
    <Style Selector="Button.toolbar">
        <Setter Property="Height" Value="52" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource BlueDarken4}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeXLarge}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="Button.toolbar:pressed">
        <Setter Property="RenderTransform" Value="none" />
    </Style>

    <Style Selector="Button.toolbar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BlueDarken4}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.toolbar:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BlueDarken2}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.toolbar.selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BlueDarken1}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Page -->
    <Style Selector="Button.command">
        <Setter Property="Height" Value="60" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="24" />
    </Style>

    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Panel -->
    <Style Selector="Border.panel">
        <Setter Property="Padding" Value="{StaticResource PaddingNormal}" />
        <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderThicknessThin}" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSmall}" />
    </Style>

    <Style Selector="TextBlock.panel-title">
        <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PanelTitleBrush}" />
    </Style>

    <Style Selector="TextBlock.panel-value">
        <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Foreground" Value="{DynamicResource PanelTitleBrush}" />
    </Style>

    <Style Selector="TextBlock.panel-note">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource PanelNoteBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.panel-header">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PanelNoteBrush}" />
    </Style>

    <Style Selector="TextBlock.panel-name">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource PanelNoteBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="TextBlock.panel-text">
        <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="Button.panel-button">
        <Setter Property="Height" Value="40" />
        <Setter Property="MinWidth" Value="88" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMedium}" />
    </Style>

    <!-- Scroll -->
    <Style Selector="ScrollViewer.gutter">
        <Setter Property="Padding" Value="{StaticResource ScrollGutter}" />
    </Style>

    <!-- Card -->
    <Style Selector="TextBlock.card-title">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeXLarge}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.card-note">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeLarge}" />
        <Setter Property="Foreground" Value="{DynamicResource PanelNoteBrush}" />
    </Style>

    <Style Selector="TextBlock.card-meta">
        <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}" />
        <Setter Property="Foreground" Value="{DynamicResource PanelNoteBrush}" />
    </Style>

    <Style Selector="TextBlock.card-error">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="Foreground" Value="{StaticResource ChartRed}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.code">
        <Setter Property="FontFamily" Value="monospace" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="Border.scan-card">
        <Setter Property="BorderThickness" Value="{StaticResource BorderThicknessNormal}" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.3" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.scan-card.flash">
        <Setter Property="BorderBrush" Value="{StaticResource ChartGreen}" />
    </Style>

    <!-- Device -->
    <Style Selector="Border.device-state">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderThicknessNormal}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PanelNoteBrush}" />
        <Setter Property="Background" Value="{DynamicResource PanelNoteBrush}" />
    </Style>
    <Style Selector="Border.device-state.running">
        <Setter Property="BorderBrush" Value="{StaticResource ChartOrange}" />
        <Setter Property="Background" Value="{StaticResource ChartOrange}" />
    </Style>
    <Style Selector="Border.device-state.connected">
        <Setter Property="BorderBrush" Value="{StaticResource ChartGreen}" />
        <Setter Property="Background" Value="{StaticResource ChartGreen}" />
    </Style>
    <Style Selector="Border.device-state.error">
        <Setter Property="BorderBrush" Value="{StaticResource ChartRed}" />
        <Setter Property="Background" Value="{StaticResource ChartRed}" />
    </Style>
    <Style Selector="Border.device-state.disabled">
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Chart -->
    <Style Selector="controls|SeriesChart">
        <Setter Property="Palette" Value="{StaticResource ChartBlueShades}" />
        <Setter Property="Foreground" Value="{DynamicResource PanelNoteBrush}" />
        <Setter Property="GridBrush" Value="{DynamicResource PanelBorderBrush}" />
    </Style>

    <Style Selector="controls|BarChart">
        <Setter Property="Fill" Value="{StaticResource ChartOrange}" />
        <Setter Property="Foreground" Value="{DynamicResource PanelNoteBrush}" />
        <Setter Property="GridBrush" Value="{DynamicResource PanelBorderBrush}" />
    </Style>

    <Style Selector="controls|SegmentGauge">
        <Setter Property="Foreground" Value="{DynamicResource PanelNoteBrush}" />
    </Style>

</Styles>
