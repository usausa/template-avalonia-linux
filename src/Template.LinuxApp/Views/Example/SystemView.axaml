<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/avalonia"
             xmlns:local="clr-namespace:Template.LinuxApp.Views.Example"
             xmlns:controls="clr-namespace:Template.LinuxApp.Controls"
             mc:Ignorable="d"
             x:Class="Template.LinuxApp.Views.Example.SystemView"
             x:DataType="local:SystemViewModel"
             s:DataContextResolver.Type="local:SystemViewModel"
             d:DesignWidth="1280" d:DesignHeight="696">

    <UserControl.Resources>
        <DataTemplate x:Key="InfoItemTemplate"
                      x:DataType="local:InfoItem">
            <Grid ColumnDefinitions="104,*">
                <TextBlock Text="{Binding Name}"
                           Classes="panel-name" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Value}"
                           Classes="panel-text" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Grid.process > TextBlock.number">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="5*,5*,6*"
          Margin="{StaticResource PaddingSmall}"
          ColumnSpacing="{StaticResource SpacingSmall}">

        <ScrollViewer Grid.Column="0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="{StaticResource SpacingSmall}">
                <Border Classes="panel">
                    <StackPanel Spacing="{StaticResource SpacingXSmall}">
                        <TextBlock Text="Hardware"
                                   Classes="panel-title" />
                        <ItemsControl ItemsSource="{Binding Hardware}"
                                      ItemTemplate="{StaticResource InfoItemTemplate}" />
                    </StackPanel>
                </Border>

                <Border Classes="panel">
                    <StackPanel Spacing="{StaticResource SpacingXSmall}">
                        <TextBlock Text="OS"
                                   Classes="panel-title" />
                        <ItemsControl ItemsSource="{Binding Os}"
                                      ItemTemplate="{StaticResource InfoItemTemplate}" />
                    </StackPanel>
                </Border>

                <Border Classes="panel">
                    <StackPanel Spacing="{StaticResource SpacingXSmall}">
                        <TextBlock Text="Power"
                                   Classes="panel-title" />
                        <controls:SegmentGauge Label="Battery"
                                               Value="{Binding BatteryLevel}"
                                               Text="{Binding BatteryText}"
                                               Fill="{StaticResource ChartGreen}"
                                               IsVisible="{Binding HasBattery}" />
                        <ItemsControl ItemsSource="{Binding Power}"
                                      ItemTemplate="{StaticResource InfoItemTemplate}" />
                    </StackPanel>
                </Border>

                <Border Classes="panel">
                    <StackPanel Spacing="{StaticResource SpacingXSmall}">
                        <TextBlock Text="Application"
                                   Classes="panel-title" />
                        <ItemsControl ItemsSource="{Binding Application}"
                                      ItemTemplate="{StaticResource InfoItemTemplate}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="{StaticResource SpacingSmall}">
                <Border Classes="panel">
                    <StackPanel Spacing="{StaticResource SpacingSmall}">
                        <TextBlock Text="Storage"
                                   Classes="panel-title" />
                        <TextBlock Text="File systems"
                                   Classes="panel-header" />
                        <ItemsControl ItemsSource="{Binding FileSystems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="{StaticResource SpacingSmall}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:FileSystemItem">
                                    <StackPanel Spacing="2">
                                        <controls:SegmentGauge Label="{Binding Label}"
                                                               Value="{Binding Usage}"
                                                               Text="{Binding Text}"
                                                               Threshold="80"
                                                               Fill="{StaticResource ChartYellow}"
                                                               ThresholdFill="{StaticResource ChartRed}" />
                                        <TextBlock Text="{Binding Detail}"
                                                   Classes="panel-name" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Disks"
                                   Classes="panel-header" />
                        <ItemsControl ItemsSource="{Binding Disks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="{StaticResource SpacingNormal}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:DiskItem">
                                    <StackPanel Spacing="{StaticResource SpacingXSmall}">
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   Classes="panel-text" />
                                        <TextBlock Text="{Binding Detail}"
                                                   Classes="panel-name" />
                                        <TextBlock Text="{Binding Smart}"
                                                   IsVisible="{Binding !HasSmart}"
                                                   Classes="panel-name" />
                                        <controls:SegmentGauge Label="Life"
                                                               Value="{Binding Life}"
                                                               Text="{Binding LifeText}"
                                                               Fill="{StaticResource ChartGreen}"
                                                               IsVisible="{Binding HasSmart}" />
                                        <controls:SegmentGauge Label="Temperature"
                                                               Value="{Binding Temperature}"
                                                               Text="{Binding TemperatureText}"
                                                               Maximum="80"
                                                               Fill="{StaticResource ChartRed}"
                                                               IsVisible="{Binding HasSmart}" />
                                        <ItemsControl ItemsSource="{Binding Attributes}"
                                                      ItemTemplate="{StaticResource InfoItemTemplate}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Classes="panel">
                    <StackPanel Spacing="{StaticResource SpacingSmall}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="USB devices"
                                       Classes="panel-title" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding UsbSummary}"
                                       Classes="panel-name" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding UsbDevices}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="{StaticResource SpacingXSmall}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:UsbItem">
                                    <StackPanel Margin="{Binding Indent}">
                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="{StaticResource SpacingSmall}">
                                            <TextBlock Text="{Binding Name}"
                                                       Classes="panel-text" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Speed}"
                                                       Classes="panel-name" />
                                        </Grid>
                                        <TextBlock Text="{Binding Detail}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Classes="panel-name" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Changes"
                                   IsVisible="{Binding HasUsbEvents}"
                                   Classes="panel-header" />
                        <ItemsControl ItemsSource="{Binding UsbEvents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding}"
                                               Classes="panel-name" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="2"
                Classes="panel">
            <DockPanel>
                <Grid DockPanel.Dock="Top"
                      ColumnDefinitions="*,Auto">
                    <TextBlock Text="Processes"
                               Classes="panel-title" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding ProcessSummary}"
                               Classes="panel-name" />
                </Grid>
                <Grid DockPanel.Dock="Top"
                      Margin="0,6,0,2"
                      ColumnDefinitions="48,*,64,56,72,52,16"
                      ColumnSpacing="{StaticResource SpacingSmall}"
                      Classes="process">
                    <TextBlock Text="PID"
                               Classes="panel-header number" />
                    <TextBlock Grid.Column="1"
                               Text="Name"
                               Classes="panel-header" />
                    <TextBlock Grid.Column="2"
                               Text="User"
                               Classes="panel-header" />
                    <TextBlock Grid.Column="3"
                               Text="CPU"
                               Classes="panel-header number" />
                    <TextBlock Grid.Column="4"
                               Text="Memory"
                               Classes="panel-header number" />
                    <TextBlock Grid.Column="5"
                               Text="Threads"
                               Classes="panel-header number" />
                    <TextBlock Grid.Column="6"
                               Text="S"
                               Classes="panel-header" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Processes}"
                              ClipToBounds="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:ProcessItem">
                            <Grid ColumnDefinitions="48,*,64,56,72,52,16"
                                  ColumnSpacing="{StaticResource SpacingSmall}"
                                  Classes="process">
                                <TextBlock Text="{Binding ProcessId}"
                                           Classes="panel-text number" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Name}"
                                           Classes="panel-text" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding User}"
                                           Classes="panel-text" />
                                <TextBlock Grid.Column="3"
                                           Text="{Binding Cpu}"
                                           Classes="panel-text number" />
                                <TextBlock Grid.Column="4"
                                           Text="{Binding Memory}"
                                           Classes="panel-text number" />
                                <TextBlock Grid.Column="5"
                                           Text="{Binding Threads}"
                                           Classes="panel-text number" />
                                <TextBlock Grid.Column="6"
                                           Text="{Binding State}"
                                           Classes="panel-text" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <TextBlock Grid.Column="1" Grid.ColumnSpan="2"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsVisible="{Binding !IsSupported}"
                   Text="System information is available on Linux."
                   Classes="panel-note" />
    </Grid>

</UserControl>
