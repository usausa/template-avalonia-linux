<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="using:System"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:info="using:LinuxDotNet.SystemInfo"
             xmlns:s="http://smart/avalonia"
             xmlns:controls="clr-namespace:Template.LinuxApp.Controls"
             xmlns:converters="clr-namespace:Template.LinuxApp.Converters"
             xmlns:services="clr-namespace:Template.LinuxApp.Services"
             xmlns:module="clr-namespace:Template.LinuxApp.Views.Example"
             mc:Ignorable="d"
             x:Class="Template.LinuxApp.Views.Example.SystemView"
             x:DataType="module:SystemViewModel"
             s:DataContextResolver.Type="module:SystemViewModel"
             d:DesignWidth="1280" d:DesignHeight="696">

    <UserControl.Resources>
        <s:MapToTextConverter x:Key="ProcessStateConverter"
                              DefaultValue="?">
            <s:MapToTextConverter.Entries>
                <s:MapToTextEntry Key="{x:Static info:ProcessState.Running}"
                                  Value="R" />
                <s:MapToTextEntry Key="{x:Static info:ProcessState.Sleeping}"
                                  Value="S" />
                <s:MapToTextEntry Key="{x:Static info:ProcessState.DiskSleep}"
                                  Value="D" />
                <s:MapToTextEntry Key="{x:Static info:ProcessState.Zombie}"
                                  Value="Z" />
                <s:MapToTextEntry Key="{x:Static info:ProcessState.Stopped}"
                                  Value="T" />
                <s:MapToTextEntry Key="{x:Static info:ProcessState.TracingStop}"
                                  Value="t" />
                <s:MapToTextEntry Key="{x:Static info:ProcessState.Idle}"
                                  Value="I" />
            </s:MapToTextConverter.Entries>
        </s:MapToTextConverter>
        <s:MapToTextConverter x:Key="MainsConverter"
                              DefaultValue="—">
            <s:MapToTextConverter.Entries>
                <s:MapToTextEntry Key="{x:True}"
                                  Value="Online" />
                <s:MapToTextEntry Key="{x:False}"
                                  Value="Offline" />
            </s:MapToTextConverter.Entries>
        </s:MapToTextConverter>
        <converters:UsbClassConverter x:Key="UsbClassConverter" />
        <converters:UsbSpeedConverter x:Key="UsbSpeedConverter" />
        <converters:JoinConverter x:Key="JoinConverter" />
        <converters:CountConverter x:Key="DeviceCountConverter"
                                   Plural="devices" Singular="device" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Grid.process > TextBlock.number">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="5*,5*,6*"
          Margin="{StaticResource PaddingSmall}"
          ColumnSpacing="{StaticResource SpacingSmall}">

        <ScrollViewer Grid.Column="0"
                      Classes="gutter"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="{StaticResource SpacingSmall}">
                <Border Classes="panel">
                    <StackPanel Spacing="{StaticResource SpacingXSmall}">
                        <TextBlock Classes="panel-title"
                                   Text="Hardware" />
                        <ContentControl Content="{Binding Host}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate x:DataType="services:HostSnapshot">
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                          ColumnDefinitions="104,*">
                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Classes="panel-name"
                                                   Text="Model" />
                                        <WrapPanel Grid.Row="0" Grid.Column="1"
                                                   ItemSpacing="6">
                                            <TextBlock Classes="panel-text"
                                                       Text="{Binding Vendor}" />
                                            <TextBlock Classes="panel-text"
                                                       Text="{Binding ProductName}" />
                                        </WrapPanel>
                                        <TextBlock Grid.Row="1" Grid.Column="0"
                                                   Classes="panel-name"
                                                   Text="Board" />
                                        <WrapPanel Grid.Row="1" Grid.Column="1"
                                                   ItemSpacing="6">
                                            <TextBlock Classes="panel-text"
                                                       Text="{Binding BoardVendor}" />
                                            <TextBlock Classes="panel-text"
                                                       Text="{Binding BoardName}" />
                                        </WrapPanel>
                                        <TextBlock Grid.Row="2" Grid.Column="0"
                                                   Classes="panel-name"
                                                   Text="BIOS" />
                                        <WrapPanel Grid.Row="2" Grid.Column="1"
                                                   ItemSpacing="6">
                                            <TextBlock Classes="panel-text"
                                                       Text="{Binding BiosVendor}" />
                                            <TextBlock Classes="panel-text"
                                                       Text="{Binding BiosVersion}" />
                                            <TextBlock Classes="panel-text"
                                                       IsVisible="{Binding BiosDate, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                       Text="{Binding BiosDate, StringFormat='({0})'}" />
                                        </WrapPanel>
                                        <TextBlock Grid.Row="3" Grid.Column="0"
                                                   Classes="panel-name"
                                                   Text="CPU" />
                                        <TextBlock Grid.Row="3" Grid.Column="1"
                                                   Classes="panel-text"
                                                   Text="{Binding Cpu}" />
                                        <TextBlock Grid.Row="4" Grid.Column="0"
                                                   Classes="panel-name"
                                                   Text="Cores" />
                                        <TextBlock Grid.Row="4" Grid.Column="1"
                                                   Classes="panel-text">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} cores, {1} threads">
                                                    <Binding Path="Cores" />
                                                    <Binding Path="Threads" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Grid.Row="5" Grid.Column="0"
                                                   Classes="panel-name"
                                                   Text="Clock" />
                                        <TextBlock Grid.Row="5" Grid.Column="1"
                                                   Classes="panel-text"
                                                   Text="{Binding ClockMhz, StringFormat='{}{0:F0} MHz max', TargetNullValue=—}" />
                                        <TextBlock Grid.Row="6" Grid.Column="0"
                                                   Classes="panel-name"
                                                   Text="Cache" />
                                        <TextBlock Grid.Row="6" Grid.Column="1"
                                                   Classes="panel-text">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="L1d {0}, L1i {1}, L2 {2}, L3 {3}">
                                                    <Binding Path="L1DCache"
                                                             Converter="{StaticResource ByteSizeConverter}" />
                                                    <Binding Path="L1ICache"
                                                             Converter="{StaticResource ByteSizeConverter}" />
                                                    <Binding Path="L2Cache"
                                                             Converter="{StaticResource ByteSizeConverter}" />
                                                    <Binding Path="L3Cache"
                                                             Converter="{StaticResource ByteSizeConverter}" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Grid.Row="7" Grid.Column="0"
                                                   Classes="panel-name"
                                                   Text="Memory" />
                                        <TextBlock Grid.Row="7" Grid.Column="1"
                                                   Classes="panel-text"
                                                   Text="{Binding Memory, Converter={StaticResource ByteSizeConverter}}" />
                                    </Grid>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </StackPanel>
                </Border>

                <Border Classes="panel">
                    <StackPanel Spacing="{StaticResource SpacingXSmall}">
                        <TextBlock Classes="panel-title"
                                   Text="OS" />
                        <ContentControl Content="{Binding Host}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate x:DataType="services:HostSnapshot">
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                          ColumnDefinitions="104,*">
                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Classes="panel-name"
                                                   Text="Distribution" />
                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                   Classes="panel-text"
                                                   Text="{Binding Distribution}" />
                                        <TextBlock Grid.Row="1" Grid.Column="0"
                                                   Classes="panel-name"
                                                   Text="Kernel" />
                                        <WrapPanel Grid.Row="1" Grid.Column="1"
                                                   ItemSpacing="6">
                                            <TextBlock Classes="panel-text"
                                                       Text="{Binding OsType}" />
                                            <TextBlock Classes="panel-text"
                                                       Text="{Binding OsRelease}" />
                                        </WrapPanel>
                                        <TextBlock Grid.Row="2" Grid.Column="0"
                                                   Classes="panel-name"
                                                   Text="Architecture" />
                                        <TextBlock Grid.Row="2" Grid.Column="1"
                                                   Classes="panel-text"
                                                   Text="{Binding Architecture}" />
                                        <TextBlock Grid.Row="3" Grid.Column="0"
                                                   Classes="panel-name"
                                                   Text="Host" />
                                        <TextBlock Grid.Row="3" Grid.Column="1"
                                                   Classes="panel-text"
                                                   Text="{Binding HostName}" />
                                        <TextBlock Grid.Row="4" Grid.Column="0"
                                                   Classes="panel-name"
                                                   VerticalAlignment="Top"
                                                   Text="Address" />
                                        <TextBlock Grid.Row="4" Grid.Column="1"
                                                   Classes="panel-text"
                                                   IsVisible="{Binding !Addresses.Count}"
                                                   Text="—" />
                                        <ItemsControl Grid.Row="4" Grid.Column="1"
                                                      ItemsSource="{Binding Addresses}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="services:NetworkAddress">
                                                    <TextBlock Classes="panel-text">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0} {1}">
                                                                <Binding Path="Interface" />
                                                                <Binding Path="Address" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Grid.Row="5" Grid.Column="0"
                                                   Classes="panel-name"
                                                   VerticalAlignment="Top"
                                                   Text="Wireless" />
                                        <TextBlock Grid.Row="5" Grid.Column="1"
                                                   Classes="panel-text"
                                                   IsVisible="{Binding !Wireless.Count}"
                                                   Text="—" />
                                        <ItemsControl Grid.Row="5" Grid.Column="1"
                                                      ItemsSource="{Binding Wireless}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="services:WirelessLink">
                                                    <TextBlock Classes="panel-text">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0} {1:F0} dBm, quality {2:F0}">
                                                                <Binding Path="Interface" />
                                                                <Binding Path="SignalLevel" />
                                                                <Binding Path="LinkQuality" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Grid.Row="6" Grid.Column="0"
                                                   Classes="panel-name"
                                                   Text="Boot" />
                                        <TextBlock Grid.Row="6" Grid.Column="1"
                                                   Classes="panel-text"
                                                   Text="{Binding BootTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}', TargetNullValue=—}" />
                                        <TextBlock Grid.Row="7" Grid.Column="0"
                                                   Classes="panel-name"
                                                   Text="Uptime" />
                                        <TextBlock Grid.Row="7" Grid.Column="1"
                                                   Classes="panel-text"
                                                   Text="{Binding Uptime, Converter={StaticResource DurationConverter}}" />
                                    </Grid>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </StackPanel>
                </Border>

                <Border Classes="panel">
                    <StackPanel Spacing="{StaticResource SpacingXSmall}">
                        <TextBlock Classes="panel-title"
                                   Text="Power" />
                        <ContentControl Content="{Binding Power}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate x:DataType="services:PowerSnapshot">
                                    <StackPanel Spacing="{StaticResource SpacingXSmall}">
                                        <controls:SegmentGauge IsVisible="{Binding HasBattery}"
                                                               Value="{Binding Capacity, TargetNullValue={x:Static sys:Double.NaN}}"
                                                               Text="{Binding Capacity, StringFormat='{}{0}%', TargetNullValue=—}"
                                                               Fill="{StaticResource ChartGreen}"
                                                               Label="Battery" />
                                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                              ColumnDefinitions="104,*">
                                            <TextBlock Grid.Row="0" Grid.Column="0"
                                                       Classes="panel-name"
                                                       Text="AC" />
                                            <TextBlock Grid.Row="0" Grid.Column="1"
                                                       Classes="panel-text"
                                                       Text="{Binding MainsOnline, Converter={StaticResource MainsConverter}}" />
                                            <TextBlock Grid.Row="1" Grid.Column="0"
                                                       Classes="panel-name"
                                                       Text="Battery" />
                                            <TextBlock Grid.Row="1" Grid.Column="1"
                                                       Classes="panel-text"
                                                       Text="{Binding Status, TargetNullValue='Not present'}" />
                                            <TextBlock Grid.Row="2" Grid.Column="0"
                                                       Classes="panel-name"
                                                       Text="Voltage" />
                                            <TextBlock Grid.Row="2" Grid.Column="1"
                                                       Classes="panel-text"
                                                       Text="{Binding Voltage, StringFormat='{}{0:F2} V', TargetNullValue=—}" />
                                            <TextBlock Grid.Row="3" Grid.Column="0"
                                                       Classes="panel-name"
                                                       Text="Current" />
                                            <TextBlock Grid.Row="3" Grid.Column="1"
                                                       Classes="panel-text"
                                                       Text="{Binding Current, StringFormat='{}{0:F2} A', TargetNullValue=—}" />
                                            <TextBlock Grid.Row="4" Grid.Column="0"
                                                       Classes="panel-name"
                                                       Text="Charge" />
                                            <TextBlock Grid.Row="4" Grid.Column="1"
                                                       Classes="panel-text"
                                                       IsVisible="{Binding HasBattery}">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0:N0} / {1:N0} mAh">
                                                        <Binding Path="Charge" />
                                                        <Binding Path="ChargeFull" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <TextBlock Grid.Row="4" Grid.Column="1"
                                                       Classes="panel-text"
                                                       IsVisible="{Binding !HasBattery}"
                                                       Text="—" />
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </StackPanel>
                </Border>

                <Border Classes="panel">
                    <StackPanel Spacing="{StaticResource SpacingSmall}">
                        <TextBlock Classes="panel-title"
                                   Text="File systems" />
                        <ItemsControl ItemsSource="{Binding FileSystems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="{StaticResource SpacingSmall}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="services:FileSystemEntry">
                                    <StackPanel Spacing="2">
                                        <controls:SegmentGauge Value="{Binding Usage, TargetNullValue={x:Static sys:Double.NaN}}"
                                                               Text="{Binding Usage, StringFormat='{}{0:F0}%', TargetNullValue=—}"
                                                               Fill="{StaticResource ChartYellow}"
                                                               Threshold="80"
                                                               ThresholdFill="{StaticResource ChartRed}">
                                            <controls:SegmentGauge.Label>
                                                <MultiBinding StringFormat="{}{0}  {1}  {2}{3}">
                                                    <Binding Path="MountPoint" />
                                                    <Binding Path="FileSystem" />
                                                    <Binding Path="Device" />
                                                    <Binding Path="ReadOnly"
                                                             Converter="{s:BoolToText True='  ro', False=''}" />
                                                </MultiBinding>
                                            </controls:SegmentGauge.Label>
                                        </controls:SegmentGauge>
                                        <TextBlock Classes="panel-name">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} used of {1}, {2} free">
                                                    <Binding Path="Used"
                                                             Converter="{StaticResource ByteSizeConverter}" />
                                                    <Binding Path="Total"
                                                             Converter="{StaticResource ByteSizeConverter}" />
                                                    <Binding Path="Available"
                                                             Converter="{StaticResource ByteSizeConverter}" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="1"
                Classes="panel">
            <DockPanel>
                <Grid DockPanel.Dock="Top"
                      ColumnDefinitions="*,Auto"
                      Margin="0,0,0,8">
                    <TextBlock Classes="panel-title"
                               Text="USB devices" />
                    <TextBlock Grid.Column="1"
                               Classes="panel-name"
                               Text="{Binding UsbDevices.Count, Converter={StaticResource DeviceCountConverter}}" />
                </Grid>
                <ScrollViewer Classes="gutter"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="{StaticResource SpacingSmall}">
                        <ItemsControl ItemsSource="{Binding UsbDevices}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="{StaticResource SpacingXSmall}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="module:UsbItem">
                                    <StackPanel Margin="{Binding Indent}">
                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="{StaticResource SpacingSmall}">
                                            <TextBlock Classes="panel-text"
                                                       IsVisible="{Binding Name, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                       Text="{Binding Name}" />
                                            <TextBlock Grid.Column="0"
                                                       Classes="panel-text"
                                                       Text="USB hub">
                                                <TextBlock.IsVisible>
                                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                        <Binding Path="Name"
                                                                 Converter="{x:Static StringConverters.IsNullOrEmpty}" />
                                                        <Binding Path="IsHub" />
                                                    </MultiBinding>
                                                </TextBlock.IsVisible>
                                            </TextBlock>
                                            <TextBlock Grid.Column="0"
                                                       Classes="panel-text"
                                                       Text="{Binding Classes, Converter={StaticResource UsbClassConverter}, StringFormat='{}{0} device'}">
                                                <TextBlock.IsVisible>
                                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                        <Binding Path="Name"
                                                                 Converter="{x:Static StringConverters.IsNullOrEmpty}" />
                                                        <Binding Path="!IsHub" />
                                                    </MultiBinding>
                                                </TextBlock.IsVisible>
                                            </TextBlock>
                                            <TextBlock Grid.Column="1"
                                                       Classes="panel-name"
                                                       Text="{Binding Speed, Converter={StaticResource UsbSpeedConverter}}" />
                                        </Grid>
                                        <TextBlock Classes="panel-name"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0}  {1:x4}:{2:x4}  {3}  {4}  {5}">
                                                    <Binding Path="Port" />
                                                    <Binding Path="VendorId" />
                                                    <Binding Path="ProductId" />
                                                    <Binding Path="Classes"
                                                             Converter="{StaticResource UsbClassConverter}" />
                                                    <Binding Path="Drivers"
                                                             Converter="{StaticResource JoinConverter}" />
                                                    <Binding Path="Files"
                                                             Converter="{StaticResource JoinConverter}" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Classes="panel-header"
                                   IsVisible="{Binding HasUsbEvents}"
                                   Text="Changes" />
                        <ItemsControl ItemsSource="{Binding UsbEvents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="module:UsbEventItem">
                                    <TextBlock Classes="panel-name">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0:HH:mm:ss} {1} {2} ({3})">
                                                <Binding Path="Time" />
                                                <Binding Path="Connected"
                                                         Converter="{s:BoolToText True=Connected, False=Disconnected}" />
                                                <Binding Path="Name" />
                                                <Binding Path="Port" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border Grid.Column="2"
                Classes="panel">
            <DockPanel>
                <Grid DockPanel.Dock="Top"
                      ColumnDefinitions="*,Auto">
                    <TextBlock Classes="panel-title"
                               Text="Processes" />
                    <TextBlock Grid.Column="1"
                               Classes="panel-name">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0:N0} processes, {1:N0} threads">
                                <Binding Path="ProcessCount" />
                                <Binding Path="ThreadCount" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Grid>
                <Grid DockPanel.Dock="Top"
                      Classes="process"
                      ColumnDefinitions="48,*,64,56,72,52,16"
                      Margin="0,6,0,2"
                      ColumnSpacing="{StaticResource SpacingSmall}">
                    <TextBlock Classes="panel-header number"
                               Text="PID" />
                    <TextBlock Grid.Column="1"
                               Classes="panel-header"
                               Text="Name" />
                    <TextBlock Grid.Column="2"
                               Classes="panel-header"
                               Text="User" />
                    <TextBlock Grid.Column="3"
                               Classes="panel-header number"
                               Text="CPU" />
                    <TextBlock Grid.Column="4"
                               Classes="panel-header number"
                               Text="Memory" />
                    <TextBlock Grid.Column="5"
                               Classes="panel-header number"
                               Text="Threads" />
                    <TextBlock Grid.Column="6"
                               Classes="panel-header"
                               Text="S" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Processes}"
                              ClipToBounds="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="services:ProcessEntry">
                            <Grid Classes="process"
                                  ColumnDefinitions="48,*,64,56,72,52,16"
                                  ColumnSpacing="{StaticResource SpacingSmall}">
                                <TextBlock Classes="panel-text number"
                                           Text="{Binding ProcessId}" />
                                <TextBlock Grid.Column="1"
                                           Classes="panel-text"
                                           Text="{Binding Name}" />
                                <TextBlock Grid.Column="2"
                                           Classes="panel-text"
                                           Text="{Binding User}" />
                                <TextBlock Grid.Column="3"
                                           Classes="panel-text number"
                                           Text="{Binding CpuUsage, StringFormat='{}{0:F1}%', TargetNullValue=—}" />
                                <TextBlock Grid.Column="4"
                                           Classes="panel-text number"
                                           Text="{Binding Memory, Converter={StaticResource ByteSizeConverter}}" />
                                <TextBlock Grid.Column="5"
                                           Classes="panel-text number"
                                           Text="{Binding Threads}" />
                                <TextBlock Grid.Column="6"
                                           Classes="panel-text"
                                           Text="{Binding State, Converter={StaticResource ProcessStateConverter}}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <TextBlock Grid.Column="1" Grid.ColumnSpan="2"
                   Classes="panel-note"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsVisible="{Binding !IsSupported}"
                   Text="System information is available on Linux." />
    </Grid>

</UserControl>
