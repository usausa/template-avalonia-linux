<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="using:System"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:disk="using:LinuxDotNet.Disk"
             xmlns:s="http://smart/avalonia"
             xmlns:controls="clr-namespace:Template.LinuxApp.Controls"
             xmlns:converters="clr-namespace:Template.LinuxApp.Converters"
             xmlns:logic="clr-namespace:Template.LinuxApp.Domain.Logic"
             xmlns:services="clr-namespace:Template.LinuxApp.Services"
             xmlns:module="clr-namespace:Template.LinuxApp.Views.Example"
             mc:Ignorable="d"
             x:Class="Template.LinuxApp.Views.Example.SmartView"
             x:DataType="module:SmartViewModel"
             s:DataContextResolver.Type="module:SmartViewModel"
             d:DesignWidth="1280" d:DesignHeight="740">

    <UserControl.Resources>
        <s:MapToBrushConverter x:Key="HealthBrushConverter"
                               DefaultValue="{StaticResource GrayDefault}">
            <s:MapToBrushConverter.Entries>
                <s:MapToBrushEntry Key="{x:Static logic:SmartHealth.Good}"
                                   Value="{StaticResource ChartGreen}" />
                <s:MapToBrushEntry Key="{x:Static logic:SmartHealth.Warning}"
                                   Value="{StaticResource ChartOrange}" />
                <s:MapToBrushEntry Key="{x:Static logic:SmartHealth.Critical}"
                                   Value="{StaticResource ChartRed}" />
            </s:MapToBrushConverter.Entries>
        </s:MapToBrushConverter>
        <s:MapToBrushConverter x:Key="StatBrushConverter"
                               DefaultValue="{StaticResource ChartBlue}">
            <s:MapToBrushConverter.Entries>
                <s:MapToBrushEntry Key="{x:Static logic:SmartHealth.Good}"
                                   Value="{StaticResource ChartGreen}" />
                <s:MapToBrushEntry Key="{x:Static logic:SmartHealth.Warning}"
                                   Value="{StaticResource ChartOrange}" />
                <s:MapToBrushEntry Key="{x:Static logic:SmartHealth.Critical}"
                                   Value="{StaticResource ChartRed}" />
            </s:MapToBrushConverter.Entries>
        </s:MapToBrushConverter>
        <s:MapToBrushConverter x:Key="RowBrushConverter"
                               DefaultValue="Transparent">
            <s:MapToBrushConverter.Entries>
                <s:MapToBrushEntry Key="{x:Static logic:SmartHealth.Good}"
                                   Value="{StaticResource ChartGreen}" />
                <s:MapToBrushEntry Key="{x:Static logic:SmartHealth.Warning}"
                                   Value="{StaticResource ChartOrange}" />
                <s:MapToBrushEntry Key="{x:Static logic:SmartHealth.Critical}"
                                   Value="{StaticResource ChartRed}" />
            </s:MapToBrushConverter.Entries>
        </s:MapToBrushConverter>
        <s:MapToTextConverter x:Key="DiskTypeConverter">
            <s:MapToTextConverter.Entries>
                <s:MapToTextEntry Key="{x:Static disk:DiskType.Nvme}"
                                  Value="NVMe" />
                <s:MapToTextEntry Key="{x:Static disk:DiskType.Scsi}"
                                  Value="SATA/SCSI" />
                <s:MapToTextEntry Key="{x:Static disk:DiskType.Ide}"
                                  Value="IDE" />
                <s:MapToTextEntry Key="{x:Static disk:DiskType.Mmc}"
                                  Value="MMC" />
                <s:MapToTextEntry Key="{x:Static disk:DiskType.Virtual}"
                                  Value="Virtual" />
            </s:MapToTextConverter.Entries>
        </s:MapToTextConverter>
        <s:MapToTextConverter x:Key="AssessmentConverter">
            <s:MapToTextConverter.Entries>
                <s:MapToTextEntry Key="{x:Static disk:SmartAssessment.Passed}"
                                  Value="Self-assessment Passed" />
                <s:MapToTextEntry Key="{x:Static disk:SmartAssessment.Failed}"
                                  Value="Self-assessment Failed" />
            </s:MapToTextConverter.Entries>
        </s:MapToTextConverter>
        <s:MapToTextConverter x:Key="MessageConverter">
            <s:MapToTextConverter.Entries>
                <s:MapToTextEntry Key="{x:Static services:SmartState.RequiresPermission}"
                                  Value="SMART needs permission" />
                <s:MapToTextEntry Key="{x:Static services:SmartState.Unsupported}"
                                  Value="SMART is not supported" />
            </s:MapToTextConverter.Entries>
        </s:MapToTextConverter>
        <s:MapToTextConverter x:Key="MessageDetailConverter">
            <s:MapToTextConverter.Entries>
                <s:MapToTextEntry Key="{x:Static services:SmartState.RequiresPermission}"
                                  Value="Run as root, or give the executable CAP_SYS_RAWIO (SATA) and CAP_SYS_ADMIN (NVMe) and add the user to the disk group. See docs/kiosk.md." />
                <s:MapToTextEntry Key="{x:Static services:SmartState.Unsupported}"
                                  Value="Memory cards, virtual disks and some USB adapters do not report SMART." />
            </s:MapToTextConverter.Entries>
        </s:MapToTextConverter>
        <converters:SmartAttributeNameConverter x:Key="AttributeNameConverter" />
        <converters:SmartRawValueConverter x:Key="RawValueConverter" />
        <converters:SmartIssueConverter x:Key="IssueConverter" />
        <converters:SmartValueConverter x:Key="ValueConverter" />
        <converters:CountConverter x:Key="AttributeCountConverter"
                                   Plural="attributes" Singular="attribute" />
        <converters:CountConverter x:Key="ValueCountConverter"
                                   Plural="values" Singular="value" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.disk-tab">
            <Setter Property="BorderThickness" Value="{StaticResource BorderThicknessNormal}" />
        </Style>
        <Style Selector="Border.disk-tab.selected">
            <Setter Property="BorderBrush" Value="{StaticResource ChartBlue}" />
        </Style>
        <Style Selector="Border.health">
            <Setter Property="Padding" Value="24,6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.health > TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Grid.row">
            <Setter Property="Height" Value="30" />
        </Style>
        <Style Selector="Grid.row > TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeMedium}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="Grid > TextBlock.number">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style Selector="Grid.row > TextBlock.note">
            <Setter Property="Foreground" Value="{DynamicResource PanelNoteBrush}" />
        </Style>
        <Style Selector="Grid.row > TextBlock.mono">
            <Setter Property="FontFamily" Value="monospace" />
        </Style>
        <Style Selector="controls|RingGauge">
            <Setter Property="MaxWidth" Value="440" />
            <Setter Property="MaxHeight" Value="440" />
            <Setter Property="Margin" Value="{StaticResource PaddingMedium}" />
            <Setter Property="Thickness" Value="22" />
            <Setter Property="Foreground" Value="{DynamicResource PanelNoteBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*"
          Margin="{StaticResource PaddingSmall}"
          RowSpacing="{StaticResource SpacingSmall}">

        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="{StaticResource SpacingNormal}">
            <ItemsControl ItemsSource="{Binding Disks}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="{StaticResource SpacingSmall}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="module:SmartDiskItem">
                        <Button Padding="0"
                                Command="{Binding $parent[ItemsControl].((module:SmartViewModel)DataContext).SelectCommand, FallbackValue={x:Null}}"
                                CommandParameter="{Binding}"
                                Background="Transparent"
                                BorderThickness="0">
                            <Border Classes="panel disk-tab"
                                    Classes.selected="{Binding IsSelected}"
                                    Width="280">
                                <Grid RowDefinitions="Auto,Auto"
                                      ColumnDefinitions="Auto,*,Auto"
                                      ColumnSpacing="{StaticResource SpacingSmall}">
                                    <Border Grid.Row="0" Grid.Column="0"
                                            Width="16" Height="16"
                                            Background="{Binding Health, Converter={StaticResource HealthBrushConverter}}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                               Classes="card-title"
                                               Text="{Binding Name}" />
                                    <TextBlock Grid.Row="0" Grid.Column="2"
                                               Classes="card-note"
                                               Text="{Binding Temperature, StringFormat='{}{0:F0} °C', TargetNullValue=—}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                               Classes="card-meta"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding Model}" />
                                </Grid>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Grid.Column="1"
                       Classes="card-note"
                       VerticalAlignment="Bottom"
                       Text="{Binding Updated, StringFormat='Updated {0:HH:mm:ss}', TargetNullValue=''}" />
        </Grid>

        <ContentControl Grid.Row="1"
                        Content="{Binding Selected}">
            <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="module:SmartDiskItem">
                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="{StaticResource SpacingSmall}">

                        <Grid Grid.Column="0"
                              RowDefinitions="Auto,*,Auto"
                              RowSpacing="{StaticResource SpacingSmall}">
                            <Border Grid.Row="0"
                                    Classes="panel">
                                <Grid RowDefinitions="Auto,Auto,Auto"
                                      ColumnDefinitions="*,Auto"
                                      ColumnSpacing="{StaticResource SpacingNormal}">
                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Classes="card-title"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding Model}" />
                                    <WrapPanel Grid.Row="1" Grid.Column="0"
                                               ItemSpacing="{StaticResource SpacingNormal}">
                                        <TextBlock Classes="card-meta"
                                                   Text="{Binding Device}" />
                                        <TextBlock Classes="card-meta"
                                                   Text="{Binding Type, Converter={StaticResource DiskTypeConverter}}" />
                                        <TextBlock Classes="card-meta"
                                                   Text="{Binding Size, Converter={StaticResource DiskSizeConverter}}" />
                                        <TextBlock Classes="card-meta"
                                                   IsVisible="{Binding Firmware, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                   Text="{Binding Firmware, StringFormat='FW {0}'}" />
                                        <TextBlock Classes="card-meta"
                                                   IsVisible="{Binding SerialNumber, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                   Text="{Binding SerialNumber, StringFormat='S/N {0}'}" />
                                        <TextBlock Classes="card-meta"
                                                   IsVisible="{Binding Removable}"
                                                   Text="Removable" />
                                        <TextBlock Classes="card-meta"
                                                   IsVisible="{Binding HasAssessment}"
                                                   Text="{Binding Assessment, Converter={StaticResource AssessmentConverter}}" />
                                    </WrapPanel>
                                    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                            Classes="health"
                                            Background="{Binding Health, Converter={StaticResource HealthBrushConverter}}">
                                        <TextBlock Text="{Binding Health}" />
                                    </Border>
                                    <ItemsControl Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                                  Margin="0,8,0,0"
                                                  ItemsSource="{Binding Issues}"
                                                  IsVisible="{Binding HasIssues}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="{StaticResource SpacingXSmall}" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="logic:SmartIssue">
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="{StaticResource SpacingSmall}">
                                                    <Border Width="14" Height="14"
                                                            VerticalAlignment="Center"
                                                            Background="{Binding Health, Converter={StaticResource HealthBrushConverter}}" />
                                                    <TextBlock Text="{Binding Converter={StaticResource IssueConverter}}"
                                                               FontSize="{StaticResource FontSizeLarge}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1"
                                    Classes="panel"
                                    IsVisible="{Binding HasSmart}">
                                <UniformGrid Rows="1"
                                             ColumnSpacing="{StaticResource SpacingSmall}">
                                    <controls:RingGauge Value="{Binding Life, TargetNullValue={x:Static sys:Double.NaN}}"
                                                        Text="{Binding Life, StringFormat='{}{0:F0}%', TargetNullValue=—}"
                                                        Fill="{Binding LifeHealth, Converter={StaticResource HealthBrushConverter}}"
                                                        Label="Life" />
                                    <controls:RingGauge Value="{Binding Temperature, TargetNullValue={x:Static sys:Double.NaN}}"
                                                        Maximum="80"
                                                        Text="{Binding Temperature, StringFormat='{}{0:F0} °C', TargetNullValue=—}"
                                                        Fill="{Binding TemperatureHealth, Converter={StaticResource HealthBrushConverter}}"
                                                        Label="Temperature" />
                                    <controls:RingGauge IsVisible="{Binding IsNvme}"
                                                        Value="{Binding Spare, TargetNullValue={x:Static sys:Double.NaN}}"
                                                        Text="{Binding Spare, StringFormat='{}{0:F0}%', TargetNullValue=—}"
                                                        Fill="{Binding SpareHealth, Converter={StaticResource HealthBrushConverter}}"
                                                        Label="Spare" />
                                </UniformGrid>
                            </Border>

                            <ItemsControl Grid.Row="2"
                                          ItemsSource="{Binding Stats}"
                                          IsVisible="{Binding HasSmart}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4"
                                                     RowSpacing="{StaticResource SpacingSmall}"
                                                     ColumnSpacing="{StaticResource SpacingSmall}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="module:SmartStatItem">
                                        <controls:StatTile Height="72"
                                                           Title="{Binding Title}"
                                                           Fill="{Binding Health, Converter={StaticResource StatBrushConverter}}">
                                            <controls:StatTile.Value>
                                                <MultiBinding Converter="{StaticResource ValueConverter}">
                                                    <Binding Path="Value" />
                                                    <Binding Path="Unit" />
                                                </MultiBinding>
                                            </controls:StatTile.Value>
                                        </controls:StatTile>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Grid.Row="1" Grid.RowSpan="2"
                                    Classes="panel"
                                    IsVisible="{Binding !HasSmart}">
                                <StackPanel Spacing="{StaticResource SpacingLarge}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path HorizontalAlignment="Center"
                                          Data="M4,16 H92 V80 H4 Z M18,62 H46 M70,62 H78"
                                          Opacity="0.4"
                                          Stroke="{DynamicResource PanelNoteBrush}"
                                          StrokeThickness="6" />
                                    <TextBlock HorizontalAlignment="Center"
                                               Text="{Binding Smart, Converter={StaticResource MessageConverter}}"
                                               FontSize="28" />
                                    <TextBlock Classes="card-note"
                                               MaxWidth="720"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Text="{Binding Smart, Converter={StaticResource MessageDetailConverter}}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Grid.Column="1"
                                Classes="panel">
                            <Grid RowDefinitions="Auto,Auto,*"
                                  RowSpacing="{StaticResource SpacingSmall}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="card-title"
                                               Text="{Binding IsNvme, Converter={s:BoolToText True='NVMe health log', False='SMART attributes'}}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="card-note"
                                               IsVisible="{Binding IsAta}"
                                               Text="{Binding Attributes.Count, Converter={StaticResource AttributeCountConverter}}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="card-note"
                                               IsVisible="{Binding IsNvme}"
                                               Text="{Binding Values.Count, Converter={StaticResource ValueCountConverter}}" />
                                </Grid>
                                <Grid Grid.Row="1"
                                      ColumnDefinitions="4,36,*,64,60,56,76,128,120"
                                      Margin="{StaticResource ScrollGutter}"
                                      ColumnSpacing="{StaticResource SpacingSmall}"
                                      IsVisible="{Binding IsAta}">
                                    <TextBlock Grid.Column="1"
                                               Classes="panel-header"
                                               Text="ID" />
                                    <TextBlock Grid.Column="2"
                                               Classes="panel-header"
                                               Text="Attribute" />
                                    <TextBlock Grid.Column="3"
                                               Classes="panel-header"
                                               Text="Type" />
                                    <TextBlock Grid.Column="4"
                                               Classes="panel-header number"
                                               Text="Current" />
                                    <TextBlock Grid.Column="5"
                                               Classes="panel-header number"
                                               Text="Worst" />
                                    <TextBlock Grid.Column="6"
                                               Classes="panel-header number"
                                               Text="Threshold" />
                                    <TextBlock Grid.Column="7"
                                               Classes="panel-header number"
                                               Text="Raw" />
                                    <TextBlock Grid.Column="8"
                                               Classes="panel-header"
                                               Text="Raw (hex)" />
                                </Grid>
                                <Grid Grid.Row="1"
                                      ColumnDefinitions="4,*,180,200"
                                      Margin="{StaticResource ScrollGutter}"
                                      ColumnSpacing="{StaticResource SpacingSmall}"
                                      IsVisible="{Binding IsNvme}">
                                    <TextBlock Grid.Column="1"
                                               Classes="panel-header"
                                               Text="Item" />
                                    <TextBlock Grid.Column="2"
                                               Classes="panel-header number"
                                               Text="Value" />
                                    <TextBlock Grid.Column="3"
                                               Classes="panel-header"
                                               Text="Detail" />
                                </Grid>
                                <ScrollViewer Grid.Row="2"
                                              Classes="gutter"
                                              VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding Attributes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="module:SmartAttributeItem">
                                                    <Grid Classes="row"
                                                          ColumnDefinitions="4,36,*,64,60,56,76,128,120"
                                                          ColumnSpacing="{StaticResource SpacingSmall}">
                                                        <Border Grid.Column="0"
                                                                Background="{Binding Health, Converter={StaticResource RowBrushConverter}}" />
                                                        <TextBlock Grid.Column="1"
                                                                   Classes="mono"
                                                                   Text="{Binding Id, StringFormat='{}{0:X2}'}" />
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding Id, Converter={StaticResource AttributeNameConverter}}" />
                                                        <TextBlock Grid.Column="3"
                                                                   Classes="note"
                                                                   Text="{Binding IsPreFailure, Converter={s:BoolToText True='Pre-fail', False='Old age'}}" />
                                                        <TextBlock Grid.Column="4"
                                                                   Classes="number"
                                                                   Text="{Binding Current}" />
                                                        <TextBlock Grid.Column="5"
                                                                   Classes="number"
                                                                   Text="{Binding Worst}" />
                                                        <TextBlock Grid.Column="6"
                                                                   Classes="number"
                                                                   Text="{Binding Threshold}" />
                                                        <TextBlock Grid.Column="7"
                                                                   Classes="number">
                                                            <TextBlock.Text>
                                                                <MultiBinding Converter="{StaticResource RawValueConverter}">
                                                                    <Binding Path="Id" />
                                                                    <Binding Path="Raw" />
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="8"
                                                                   Classes="mono note"
                                                                   Text="{Binding Raw, StringFormat='{}{0:X12}'}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding Values}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="module:SmartValueItem">
                                                    <Grid Classes="row"
                                                          ColumnDefinitions="4,*,180,200"
                                                          ColumnSpacing="{StaticResource SpacingSmall}">
                                                        <Border Grid.Column="0"
                                                                Background="{Binding Health, Converter={StaticResource RowBrushConverter}}" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Name}" />
                                                        <TextBlock Grid.Column="2"
                                                                   Classes="number">
                                                            <TextBlock.Text>
                                                                <MultiBinding Converter="{StaticResource ValueConverter}">
                                                                    <Binding Path="Value" />
                                                                    <Binding Path="Unit" />
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="3"
                                                                   Classes="note">
                                                            <TextBlock.Text>
                                                                <MultiBinding Converter="{StaticResource ValueConverter}">
                                                                    <Binding Path="Detail" />
                                                                    <Binding Path="DetailUnit" />
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                                <TextBlock Grid.Row="2"
                                           Classes="card-note"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           IsVisible="{Binding !HasSmart}"
                                           Text="No SMART data" />
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

        <TextBlock Grid.Row="1"
                   Classes="card-note"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsVisible="{Binding !IsSupported}"
                   Text="Disk information is available on Linux." />

        <TextBlock Grid.Row="1"
                   Classes="card-note"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsVisible="{Binding IsEmpty}"
                   Text="No disks found" />
    </Grid>

</UserControl>
