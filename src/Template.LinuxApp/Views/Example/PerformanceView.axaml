<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/avalonia"
             xmlns:controls="clr-namespace:Template.LinuxApp.Controls"
             xmlns:module="clr-namespace:Template.LinuxApp.Views.Example"
             mc:Ignorable="d"
             x:Class="Template.LinuxApp.Views.Example.PerformanceView"
             x:DataType="module:PerformanceViewModel"
             s:DataContextResolver.Type="module:PerformanceViewModel"
             d:DesignWidth="1280" d:DesignHeight="696">

    <UserControl.Styles>
        <Style Selector="controls|StatTile">
            <Setter Property="Height" Value="64" />
            <Setter Property="Capacity" Value="{Binding Capacity}" />
        </Style>
        <Style Selector="controls|SeriesChart">
            <Setter Property="Capacity" Value="{Binding Capacity}" />
            <Setter Property="Time" Value="{Binding Time}" />
            <Setter Property="Interval" Value="{Binding Interval}" />
        </Style>
        <Style Selector="controls|BarChart">
            <Setter Property="Capacity" Value="{Binding Capacity}" />
            <Setter Property="Time" Value="{Binding Time}" />
            <Setter Property="Interval" Value="{Binding Interval}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,5*,4*,6*"
          Margin="{StaticResource PaddingSmall}"
          RowSpacing="{StaticResource SpacingSmall}">

        <UniformGrid Grid.Row="0"
                     Rows="2" Columns="6"
                     RowSpacing="{StaticResource SpacingSmall}"
                     ColumnSpacing="{StaticResource SpacingSmall}">
            <controls:StatTile Value="{Binding Uptime, Converter={StaticResource ShortDurationConverter}}"
                               Title="Uptime"
                               Fill="{StaticResource ChartGreen}"
                               Values="{Binding UptimeDays.History}" />
            <controls:StatTile Value="{Binding Load.Current, StringFormat='{}{0:0.00}', TargetNullValue=—}"
                               Title="Load average"
                               Fill="{StaticResource ChartPurple}"
                               Values="{Binding Load.History}" />
            <controls:StatTile Value="{Binding Processes.Current, StringFormat='{}{0:N0}', TargetNullValue=—}"
                               Title="Processes"
                               Fill="{StaticResource ChartPurple}"
                               Values="{Binding Processes.History}" />
            <controls:StatTile Value="{Binding Threads.Current, StringFormat='{}{0:N0}', TargetNullValue=—}"
                               Title="Threads"
                               Fill="{StaticResource ChartPurple}"
                               Values="{Binding Threads.History}" />
            <controls:StatTile Value="{Binding FileHandles.Current, StringFormat='{}{0:N0}', TargetNullValue=—}"
                               Title="File handles"
                               Fill="{StaticResource ChartPurple}"
                               Values="{Binding FileHandles.History}" />
            <controls:StatTile Value="{Binding Connections.Current, StringFormat='{}{0:N0}', TargetNullValue=—}"
                               Title="TCP connections"
                               Fill="{StaticResource ChartPurple}"
                               Values="{Binding Connections.History}" />
            <controls:StatTile Value="{Binding Cpu.Current, StringFormat='{}{0:0.0}%', TargetNullValue=—}"
                               Minimum="0" Maximum="100"
                               Title="CPU used"
                               Fill="{StaticResource ChartBlue}"
                               Values="{Binding Cpu.History}" />
            <controls:StatTile Value="{Binding Memory.Current, StringFormat='{}{0:0.0}%', TargetNullValue=—}"
                               Minimum="0" Maximum="100"
                               Title="Memory used"
                               Fill="{StaticResource ChartBlue}"
                               Values="{Binding Memory.History}" />
            <controls:StatTile Value="{Binding Swap.Current, StringFormat='{}{0:0.0}%', TargetNullValue=—}"
                               Minimum="0" Maximum="100"
                               Title="Swap used"
                               Fill="{StaticResource ChartBlue}"
                               Values="{Binding Swap.History}" />
            <controls:StatTile Value="{Binding Battery.Current, StringFormat='{}{0:0}%', TargetNullValue=—}"
                               Minimum="0" Maximum="100"
                               Title="Battery"
                               Fill="{StaticResource ChartGreen}"
                               Values="{Binding Battery.History}" />
            <controls:StatTile Value="{Binding Power.Current, StringFormat='{}{0:0.0} W', TargetNullValue=—}"
                               Title="Power"
                               Fill="{StaticResource ChartOrange}"
                               Values="{Binding Power.History}" />
            <controls:StatTile Value="{Binding CpuTemperature.Current, StringFormat='{}{0:0} °C', TargetNullValue=—}"
                               Title="CPU temperature"
                               Fill="{StaticResource ChartRed}"
                               Values="{Binding CpuTemperature.History}" />
        </UniformGrid>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,*,*"
              ColumnSpacing="{StaticResource SpacingSmall}">
            <Border Grid.Column="0"
                    Classes="panel">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Classes="panel-title"
                               Text="CPU load (%)" />
                    <controls:SeriesChart Maximum="100"
                                          Series="{Binding CoreUsage}"
                                          ValueFormat="{}{0:0.0}%" />
                </DockPanel>
            </Border>
            <Border Grid.Column="1"
                    Classes="panel">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Classes="panel-title"
                               Text="Temperature (°C)" />
                    <controls:SeriesChart Palette="{StaticResource ChartRedShades}"
                                          Series="{Binding Temperatures}"
                                          ValueFormat="{}{0:0} °C" />
                </DockPanel>
            </Border>
            <Border Grid.Column="2"
                    Classes="panel">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Classes="panel-title"
                               Text="Clock (MHz)" />
                    <controls:SeriesChart Palette="{StaticResource ChartPurpleShades}"
                                          Series="{Binding CoreClock}"
                                          ValueFormat="{}{0:0} MHz" />
                </DockPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2"
              ColumnDefinitions="*,*"
              ColumnSpacing="{StaticResource SpacingSmall}">
            <Border Grid.Column="0"
                    Classes="panel">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Classes="panel-title"
                               Text="Disk load (%)" />
                    <controls:SeriesChart Maximum="100"
                                          Palette="{StaticResource ChartYellowShades}"
                                          Series="{Binding DiskBusy}"
                                          ValueFormat="{}{0:0.0}%" />
                </DockPanel>
            </Border>
            <Border Grid.Column="1"
                    Classes="panel">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Classes="panel-title"
                               Text="Network (KB/s)" />
                    <controls:SeriesChart Palette="{StaticResource ChartPurpleShades}"
                                          Series="{Binding Network}"
                                          ValueConverter="{StaticResource ByteRateConverter}" />
                </DockPanel>
            </Border>
        </Grid>

        <UniformGrid Grid.Row="3"
                     Rows="2" Columns="4"
                     RowSpacing="{StaticResource SpacingSmall}"
                     ColumnSpacing="{StaticResource SpacingSmall}">
            <Border Classes="panel">
                <DockPanel>
                    <Grid DockPanel.Dock="Top"
                          ColumnDefinitions="*,Auto">
                        <TextBlock Classes="panel-title"
                                   Text="Run queue" />
                        <TextBlock Grid.Column="1"
                                   Classes="panel-value"
                                   Text="{Binding RunQueue.Current, StringFormat='{}{0:N0}', TargetNullValue=—}" />
                    </Grid>
                    <controls:BarChart Values="{Binding RunQueue.History}" />
                </DockPanel>
            </Border>
            <Border Classes="panel">
                <DockPanel>
                    <Grid DockPanel.Dock="Top"
                          ColumnDefinitions="*,Auto">
                        <TextBlock Classes="panel-title"
                                   Text="Interrupts" />
                        <TextBlock Grid.Column="1"
                                   Classes="panel-value"
                                   Text="{Binding Interrupts.Current, StringFormat='{}{0:N0}/s', TargetNullValue=—}" />
                    </Grid>
                    <controls:BarChart Values="{Binding Interrupts.History}" />
                </DockPanel>
            </Border>
            <Border Classes="panel">
                <DockPanel>
                    <Grid DockPanel.Dock="Top"
                          ColumnDefinitions="*,Auto">
                        <TextBlock Classes="panel-title"
                                   Text="Context switches" />
                        <TextBlock Grid.Column="1"
                                   Classes="panel-value"
                                   Text="{Binding ContextSwitches.Current, StringFormat='{}{0:N0}/s', TargetNullValue=—}" />
                    </Grid>
                    <controls:BarChart Values="{Binding ContextSwitches.History}" />
                </DockPanel>
            </Border>
            <Border Classes="panel">
                <DockPanel>
                    <Grid DockPanel.Dock="Top"
                          ColumnDefinitions="*,Auto">
                        <TextBlock Classes="panel-title"
                                   Text="Forks" />
                        <TextBlock Grid.Column="1"
                                   Classes="panel-value"
                                   Text="{Binding Forks.Current, StringFormat='{}{0:N0}/s', TargetNullValue=—}" />
                    </Grid>
                    <controls:BarChart Values="{Binding Forks.History}" />
                </DockPanel>
            </Border>
            <Border Classes="panel">
                <DockPanel>
                    <Grid DockPanel.Dock="Top"
                          ColumnDefinitions="*,Auto">
                        <TextBlock Classes="panel-title"
                                   Text="Page faults" />
                        <TextBlock Grid.Column="1"
                                   Classes="panel-value"
                                   Text="{Binding PageFaults.Current, StringFormat='{}{0:N0}/s', TargetNullValue=—}" />
                    </Grid>
                    <controls:BarChart Values="{Binding PageFaults.History}" />
                </DockPanel>
            </Border>
            <Border Classes="panel">
                <DockPanel>
                    <Grid DockPanel.Dock="Top"
                          ColumnDefinitions="*,Auto">
                        <TextBlock Classes="panel-title"
                                   Text="Swap pages" />
                        <TextBlock Grid.Column="1"
                                   Classes="panel-value"
                                   Text="{Binding SwapPages.Current, StringFormat='{}{0:N0}/s', TargetNullValue=—}" />
                    </Grid>
                    <controls:BarChart Values="{Binding SwapPages.History}" />
                </DockPanel>
            </Border>
            <Border Classes="panel">
                <DockPanel>
                    <Grid DockPanel.Dock="Top"
                          ColumnDefinitions="*,Auto">
                        <TextBlock Classes="panel-title"
                                   Text="Disk queue" />
                        <TextBlock Grid.Column="1"
                                   Classes="panel-value"
                                   Text="{Binding DiskQueue.Current, StringFormat='{}{0:N0}', TargetNullValue=—}" />
                    </Grid>
                    <controls:BarChart Values="{Binding DiskQueue.History}" />
                </DockPanel>
            </Border>
            <Border Classes="panel">
                <DockPanel>
                    <Grid DockPanel.Dock="Top"
                          ColumnDefinitions="*,Auto">
                        <TextBlock Classes="panel-title"
                                   Text="Memory commit" />
                        <TextBlock Grid.Column="1"
                                   Classes="panel-value"
                                   Text="{Binding Commit.Current, StringFormat='{}{0:0.0}%', TargetNullValue=—}" />
                    </Grid>
                    <controls:BarChart Maximum="100"
                                       Values="{Binding Commit.History}" />
                </DockPanel>
            </Border>
        </UniformGrid>

        <TextBlock Grid.Row="1" Grid.RowSpan="3"
                   Classes="panel-note"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsVisible="{Binding !IsSupported}"
                   Text="System information is available on Linux." />
    </Grid>

</UserControl>
