<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/avalonia"
             xmlns:local="clr-namespace:Template.LinuxApp.Views.Example"
             xmlns:controls="clr-namespace:Template.LinuxApp.Controls"
             mc:Ignorable="d"
             x:Class="Template.LinuxApp.Views.Example.PerformanceView"
             x:DataType="local:PerformanceViewModel"
             s:DataContextResolver.Type="local:PerformanceViewModel"
             d:DesignWidth="1280" d:DesignHeight="696">

    <UserControl.Styles>
        <Style Selector="controls|StatTile">
            <Setter Property="Height" Value="64" />
            <Setter Property="Capacity" Value="{Binding Capacity}" />
        </Style>
        <Style Selector="controls|SeriesChart">
            <Setter Property="Capacity" Value="{Binding Capacity}" />
            <Setter Property="Time" Value="{Binding Time}" />
            <Setter Property="Interval" Value="{Binding Interval}" />
        </Style>
        <Style Selector="controls|BarChart">
            <Setter Property="Capacity" Value="{Binding Capacity}" />
            <Setter Property="Time" Value="{Binding Time}" />
            <Setter Property="Interval" Value="{Binding Interval}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,5*,4*,6*"
          Margin="{StaticResource PaddingSmall}"
          RowSpacing="{StaticResource SpacingSmall}">

        <UniformGrid Grid.Row="0"
                     Columns="6" Rows="2"
                     ColumnSpacing="{StaticResource SpacingSmall}"
                     RowSpacing="{StaticResource SpacingSmall}">
            <controls:StatTile Title="Uptime"
                               Value="{Binding Uptime, Converter={StaticResource ShortDurationConverter}}"
                               Values="{Binding UptimeDays.History}"
                               Fill="{StaticResource ChartGreen}" />
            <controls:StatTile Title="Load average"
                               Value="{Binding Load.Current, StringFormat='{}{0:0.00}', TargetNullValue=—}"
                               Values="{Binding Load.History}"
                               Fill="{StaticResource ChartPurple}" />
            <controls:StatTile Title="Processes"
                               Value="{Binding Processes.Current, StringFormat='{}{0:N0}', TargetNullValue=—}"
                               Values="{Binding Processes.History}"
                               Fill="{StaticResource ChartPurple}" />
            <controls:StatTile Title="Threads"
                               Value="{Binding Threads.Current, StringFormat='{}{0:N0}', TargetNullValue=—}"
                               Values="{Binding Threads.History}"
                               Fill="{StaticResource ChartPurple}" />
            <controls:StatTile Title="File handles"
                               Value="{Binding FileHandles.Current, StringFormat='{}{0:N0}', TargetNullValue=—}"
                               Values="{Binding FileHandles.History}"
                               Fill="{StaticResource ChartPurple}" />
            <controls:StatTile Title="TCP connections"
                               Value="{Binding Connections.Current, StringFormat='{}{0:N0}', TargetNullValue=—}"
                               Values="{Binding Connections.History}"
                               Fill="{StaticResource ChartPurple}" />
            <controls:StatTile Title="CPU used"
                               Value="{Binding Cpu.Current, StringFormat='{}{0:0.0}%', TargetNullValue=—}"
                               Values="{Binding Cpu.History}"
                               Minimum="0" Maximum="100"
                               Fill="{StaticResource ChartBlue}" />
            <controls:StatTile Title="Memory used"
                               Value="{Binding Memory.Current, StringFormat='{}{0:0.0}%', TargetNullValue=—}"
                               Values="{Binding Memory.History}"
                               Minimum="0" Maximum="100"
                               Fill="{StaticResource ChartBlue}" />
            <controls:StatTile Title="Swap used"
                               Value="{Binding Swap.Current, StringFormat='{}{0:0.0}%', TargetNullValue=—}"
                               Values="{Binding Swap.History}"
                               Minimum="0" Maximum="100"
                               Fill="{StaticResource ChartBlue}" />
            <controls:StatTile Title="Battery"
                               Value="{Binding Battery.Current, StringFormat='{}{0:0}%', TargetNullValue=—}"
                               Values="{Binding Battery.History}"
                               Minimum="0" Maximum="100"
                               Fill="{StaticResource ChartGreen}" />
            <controls:StatTile Title="Power"
                               Value="{Binding Power.Current, StringFormat='{}{0:0.0} W', TargetNullValue=—}"
                               Values="{Binding Power.History}"
                               Fill="{StaticResource ChartOrange}" />
            <controls:StatTile Title="CPU temperature"
                               Value="{Binding CpuTemperature.Current, StringFormat='{}{0:0} °C', TargetNullValue=—}"
                               Values="{Binding CpuTemperature.History}"
                               Fill="{StaticResource ChartRed}" />
        </UniformGrid>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,*,*"
              ColumnSpacing="{StaticResource SpacingSmall}">
            <Border Grid.Column="0"
                    Classes="panel">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="CPU load (%)"
                               Classes="panel-title" />
                    <controls:SeriesChart Series="{Binding CoreUsage}"
                                          ValueFormat="{}{0:0.0}%"
                                          Maximum="100" />
                </DockPanel>
            </Border>
            <Border Grid.Column="1"
                    Classes="panel">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Temperature (°C)"
                               Classes="panel-title" />
                    <controls:SeriesChart Series="{Binding Temperatures}"
                                          ValueFormat="{}{0:0} °C"
                                          Palette="{StaticResource ChartRedShades}" />
                </DockPanel>
            </Border>
            <Border Grid.Column="2"
                    Classes="panel">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Clock (MHz)"
                               Classes="panel-title" />
                    <controls:SeriesChart Series="{Binding CoreClock}"
                                          ValueFormat="{}{0:0} MHz"
                                          Palette="{StaticResource ChartPurpleShades}" />
                </DockPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2"
              ColumnDefinitions="*,*"
              ColumnSpacing="{StaticResource SpacingSmall}">
            <Border Grid.Column="0"
                    Classes="panel">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Disk load (%)"
                               Classes="panel-title" />
                    <controls:SeriesChart Series="{Binding DiskBusy}"
                                          ValueFormat="{}{0:0.0}%"
                                          Palette="{StaticResource ChartYellowShades}"
                                          Maximum="100" />
                </DockPanel>
            </Border>
            <Border Grid.Column="1"
                    Classes="panel">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Network (KB/s)"
                               Classes="panel-title" />
                    <controls:SeriesChart Series="{Binding Network}"
                                          ValueConverter="{StaticResource ByteRateConverter}"
                                          Palette="{StaticResource ChartPurpleShades}" />
                </DockPanel>
            </Border>
        </Grid>

        <UniformGrid Grid.Row="3"
                     Columns="4" Rows="2"
                     ColumnSpacing="{StaticResource SpacingSmall}"
                     RowSpacing="{StaticResource SpacingSmall}">
            <Border Classes="panel">
                <DockPanel>
                    <Grid DockPanel.Dock="Top"
                          ColumnDefinitions="*,Auto">
                        <TextBlock Text="Run queue"
                                   Classes="panel-title" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding RunQueue.Current, StringFormat='{}{0:N0}', TargetNullValue=—}"
                                   Classes="panel-value" />
                    </Grid>
                    <controls:BarChart Values="{Binding RunQueue.History}" />
                </DockPanel>
            </Border>
            <Border Classes="panel">
                <DockPanel>
                    <Grid DockPanel.Dock="Top"
                          ColumnDefinitions="*,Auto">
                        <TextBlock Text="Interrupts"
                                   Classes="panel-title" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Interrupts.Current, StringFormat='{}{0:N0}/s', TargetNullValue=—}"
                                   Classes="panel-value" />
                    </Grid>
                    <controls:BarChart Values="{Binding Interrupts.History}" />
                </DockPanel>
            </Border>
            <Border Classes="panel">
                <DockPanel>
                    <Grid DockPanel.Dock="Top"
                          ColumnDefinitions="*,Auto">
                        <TextBlock Text="Context switches"
                                   Classes="panel-title" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ContextSwitches.Current, StringFormat='{}{0:N0}/s', TargetNullValue=—}"
                                   Classes="panel-value" />
                    </Grid>
                    <controls:BarChart Values="{Binding ContextSwitches.History}" />
                </DockPanel>
            </Border>
            <Border Classes="panel">
                <DockPanel>
                    <Grid DockPanel.Dock="Top"
                          ColumnDefinitions="*,Auto">
                        <TextBlock Text="Forks"
                                   Classes="panel-title" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Forks.Current, StringFormat='{}{0:N0}/s', TargetNullValue=—}"
                                   Classes="panel-value" />
                    </Grid>
                    <controls:BarChart Values="{Binding Forks.History}" />
                </DockPanel>
            </Border>
            <Border Classes="panel">
                <DockPanel>
                    <Grid DockPanel.Dock="Top"
                          ColumnDefinitions="*,Auto">
                        <TextBlock Text="Page faults"
                                   Classes="panel-title" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding PageFaults.Current, StringFormat='{}{0:N0}/s', TargetNullValue=—}"
                                   Classes="panel-value" />
                    </Grid>
                    <controls:BarChart Values="{Binding PageFaults.History}" />
                </DockPanel>
            </Border>
            <Border Classes="panel">
                <DockPanel>
                    <Grid DockPanel.Dock="Top"
                          ColumnDefinitions="*,Auto">
                        <TextBlock Text="Swap pages"
                                   Classes="panel-title" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SwapPages.Current, StringFormat='{}{0:N0}/s', TargetNullValue=—}"
                                   Classes="panel-value" />
                    </Grid>
                    <controls:BarChart Values="{Binding SwapPages.History}" />
                </DockPanel>
            </Border>
            <Border Classes="panel">
                <DockPanel>
                    <Grid DockPanel.Dock="Top"
                          ColumnDefinitions="*,Auto">
                        <TextBlock Text="Disk queue"
                                   Classes="panel-title" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding DiskQueue.Current, StringFormat='{}{0:N0}', TargetNullValue=—}"
                                   Classes="panel-value" />
                    </Grid>
                    <controls:BarChart Values="{Binding DiskQueue.History}" />
                </DockPanel>
            </Border>
            <Border Classes="panel">
                <DockPanel>
                    <Grid DockPanel.Dock="Top"
                          ColumnDefinitions="*,Auto">
                        <TextBlock Text="Memory commit"
                                   Classes="panel-title" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Commit.Current, StringFormat='{}{0:0.0}%', TargetNullValue=—}"
                                   Classes="panel-value" />
                    </Grid>
                    <controls:BarChart Values="{Binding Commit.History}"
                                       Maximum="100" />
                </DockPanel>
            </Border>
        </UniformGrid>

        <TextBlock Grid.Row="1" Grid.RowSpan="3"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsVisible="{Binding !IsSupported}"
                   Text="System information is available on Linux."
                   Classes="panel-note" />
    </Grid>

</UserControl>
