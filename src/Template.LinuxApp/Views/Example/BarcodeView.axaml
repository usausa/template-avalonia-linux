<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/avalonia"
             xmlns:local="clr-namespace:Template.LinuxApp.Views.Example"
             xmlns:controls="clr-namespace:Template.LinuxApp.Controls"
             xmlns:converters="clr-namespace:Template.LinuxApp.Converters"
             mc:Ignorable="d"
             x:Class="Template.LinuxApp.Views.Example.BarcodeView"
             x:DataType="local:BarcodeViewModel"
             s:DataContextResolver.Type="local:BarcodeViewModel"
             d:DesignWidth="1280" d:DesignHeight="740">

    <UserControl.Resources>
        <converters:CountConverter x:Key="ScanCountConverter"
                                   Singular="scan"
                                   Plural="scans" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.source-chip">
            <Setter Property="Padding" Value="12,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource ChartBlue}" />
        </Style>
        <Style Selector="Border.source-chip.qr">
            <Setter Property="Background" Value="{StaticResource ChartPurple}" />
        </Style>
        <Style Selector="Border.source-bar">
            <Setter Property="Width" Value="4" />
            <Setter Property="Background" Value="{StaticResource ChartBlue}" />
        </Style>
        <Style Selector="Border.source-bar.qr">
            <Setter Property="Background" Value="{StaticResource ChartPurple}" />
        </Style>
        <Style Selector="Border.count-badge">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource ChartOrange}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*"
          ColumnDefinitions="*,480"
          Margin="{StaticResource PaddingSmall}"
          RowSpacing="{StaticResource SpacingSmall}"
          ColumnSpacing="{StaticResource SpacingSmall}">

        <Grid Grid.Row="0" Grid.Column="0"
              ColumnDefinitions="*,*"
              ColumnSpacing="{StaticResource SpacingSmall}">
            <controls:DeviceCard Grid.Column="0"
                                 Title="Barcode reader"
                                 Device="{Binding BarcodeDevice}"
                                 Status="{Binding BarcodeStatus}" />
            <controls:DeviceCard Grid.Column="1"
                                 Title="QR reader"
                                 Device="{Binding QrDevice}"
                                 Status="{Binding QrStatus}">
                <StackPanel Orientation="Horizontal"
                            Spacing="{StaticResource SpacingSmall}">
                    <Button Command="{Binding ResumeCommand}"
                            IsEnabled="{Binding QrStatus.IsConnected}"
                            Content="Resume"
                            Classes="panel-button" />
                    <Button Command="{Binding PauseCommand}"
                            IsEnabled="{Binding QrStatus.IsConnected}"
                            Content="Pause"
                            Classes="panel-button" />
                </StackPanel>
            </controls:DeviceCard>
        </Grid>

        <Border Grid.Row="1" Grid.Column="0"
                Padding="{StaticResource PaddingLarge}"
                Classes="panel scan-card"
                Classes.flash="{Binding IsFlashing}">
            <Panel>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsVisible="{Binding Latest, Converter={x:Static ObjectConverters.IsNull}}"
                            Spacing="{StaticResource SpacingXLarge}">
                    <Path HorizontalAlignment="Center"
                          Data="M0,0h6v96h-6z M10,0h3v96h-3z M17,0h3v96h-3z M24,0h8v96h-8z M36,0h3v96h-3z M43,0h5v96h-5z M52,0h3v96h-3z M59,0h8v96h-8z M71,0h3v96h-3z M78,0h3v96h-3z M85,0h6v96h-6z M95,0h3v96h-3z M102,0h8v96h-8z M114,0h3v96h-3z M121,0h5v96h-5z M130,0h3v96h-3z M137,0h6v96h-6z M147,0h3v96h-3z M154,0h8v96h-8z M166,0h3v96h-3z M173,0h6v96h-6z"
                          Fill="{DynamicResource PanelNoteBrush}"
                          Opacity="0.4" />
                    <TextBlock HorizontalAlignment="Center"
                               Text="Scan a barcode or QR code"
                               FontSize="28"
                               Foreground="{DynamicResource PanelNoteBrush}" />
                </StackPanel>
                <ContentControl Content="{Binding Latest}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate x:DataType="local:BarcodeHistoryItem">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Spacing="{StaticResource SpacingLarge}">
                                <StackPanel HorizontalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="{StaticResource SpacingNormal}">
                                    <Border Classes="source-chip"
                                            Classes.qr="{Binding IsQr}">
                                        <TextBlock Text="{Binding Source}"
                                                   FontSize="{StaticResource FontSizeLarge}"
                                                   FontWeight="SemiBold"
                                                   Foreground="White" />
                                    </Border>
                                    <Border IsVisible="{Binding IsRepeated}"
                                            Classes="count-badge">
                                        <TextBlock Text="{Binding Count, StringFormat='×{0}'}"
                                                   FontSize="{StaticResource FontSizeLarge}"
                                                   FontWeight="SemiBold"
                                                   Foreground="White" />
                                    </Border>
                                    <TextBlock Text="{Binding Time, StringFormat='{}{0:HH:mm:ss}'}"
                                               Classes="card-note" />
                                    <TextBlock Text="{Binding Code.Length, StringFormat='{}{0} characters'}"
                                               Classes="card-note" />
                                </StackPanel>
                                <TextBlock Text="{Binding Code}"
                                           FontSize="96"
                                           TextAlignment="Center"
                                           Classes="code" />
                            </StackPanel>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Panel>
        </Border>

        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                Classes="panel">
            <Grid RowDefinitions="Auto,*"
                  RowSpacing="{StaticResource SpacingSmall}">
                <Grid ColumnDefinitions="*,Auto,Auto"
                      ColumnSpacing="{StaticResource SpacingNormal}">
                    <TextBlock Text="History"
                               Classes="card-title" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding ScanCount, Converter={StaticResource ScanCountConverter}}"
                               Classes="card-note" />
                    <Button Grid.Column="2"
                            Command="{Binding ClearCommand}"
                            Content="Clear"
                            Classes="panel-button" />
                </Grid>
                <TextBlock Grid.Row="1"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="{Binding Latest, Converter={x:Static ObjectConverters.IsNull}}"
                           Text="No scans yet"
                           Classes="card-note" />
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              Classes="gutter">
                    <ItemsControl ItemsSource="{Binding History}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="{StaticResource SpacingSmall}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:BarcodeHistoryItem">
                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="{StaticResource SpacingSmall}">
                                    <Border Grid.Column="0"
                                            Classes="source-bar"
                                            Classes.qr="{Binding IsQr}" />
                                    <StackPanel Grid.Column="1">
                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="{StaticResource SpacingSmall}">
                                            <TextBlock Text="{Binding Code}"
                                                       FontSize="{StaticResource FontSizeXLarge}"
                                                       Classes="code" />
                                            <Border Grid.Column="1"
                                                    VerticalAlignment="Top"
                                                    IsVisible="{Binding IsRepeated}"
                                                    Classes="count-badge">
                                                <TextBlock Text="{Binding Count, StringFormat='×{0}'}"
                                                           FontSize="{StaticResource FontSizeNormal}"
                                                           FontWeight="SemiBold"
                                                           Foreground="White" />
                                            </Border>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="{StaticResource SpacingSmall}">
                                            <TextBlock Text="{Binding Time, StringFormat='{}{0:HH:mm:ss}'}"
                                                       Classes="card-meta" />
                                            <TextBlock Text="{Binding Source}"
                                                       Classes="card-meta" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

    </Grid>

</UserControl>
