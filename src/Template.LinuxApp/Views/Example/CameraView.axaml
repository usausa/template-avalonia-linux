<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/avalonia"
             xmlns:local="clr-namespace:Template.LinuxApp.Views.Example"
             xmlns:controls="clr-namespace:Template.LinuxApp.Controls"
             mc:Ignorable="d"
             x:Class="Template.LinuxApp.Views.Example.CameraView"
             x:DataType="local:CameraViewModel"
             s:DataContextResolver.Type="local:CameraViewModel"
             d:DesignWidth="1280" d:DesignHeight="740">

    <UserControl.Resources>
        <DataTemplate x:Key="InfoItemTemplate"
                      x:DataType="local:InfoItem">
            <Grid ColumnDefinitions="72,*">
                <TextBlock Text="{Binding Name}"
                           Classes="panel-name" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Value}"
                           Classes="panel-text" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowDefinitions="*,Auto"
          ColumnDefinitions="*,360">

        <Viewbox Grid.Row="0" Grid.Column="0"
                 Stretch="Uniform">
            <Panel Width="{Binding FrameWidth}"
                   Height="{Binding FrameHeight}">
                <Image Source="{Binding Bitmap}"
                       Stretch="Fill" />
                <controls:FaceBoxOverlay FaceBoxes="{Binding FaceBoxes}" />
                <controls:QrCodeOverlay Codes="{Binding QrCodes}"
                                        Stroke="{StaticResource ChartGreen}" />
            </Panel>
        </Viewbox>

        <Border Grid.Row="0" Grid.Column="0"
                Margin="3" Padding="3"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Background="#40000000" BorderBrush="#C0FFFFFF" BorderThickness="1">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                  ColumnDefinitions="Auto,Auto">
                <Grid.Styles>
                    <Style Selector="TextBlock">
                        <Setter Property="FontFamily" Value="monospace" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Foreground" Value="White" />
                    </Style>
                    <Style Selector="TextBlock.value">
                        <Setter Property="Width" Value="36" />
                        <Setter Property="TextAlignment" Value="Right" />
                    </Style>
                </Grid.Styles>
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="FPS:" />
                <TextBlock Grid.Row="0" Grid.Column="1"
                           Text="{Binding Fps, StringFormat={}{0:F1}}"
                           Classes="value" />
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="GC0/s:" />
                <TextBlock Grid.Row="1" Grid.Column="1"
                           Text="{Binding Gc0PerSec, StringFormat={}{0:F1}}"
                           Classes="value" />
                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="GC1/s:" />
                <TextBlock Grid.Row="2" Grid.Column="1"
                           Text="{Binding Gc1PerSec, StringFormat={}{0:F1}}"
                           Classes="value" />
                <TextBlock Grid.Row="3" Grid.Column="0"
                           Text="GC2/s:" />
                <TextBlock Grid.Row="3" Grid.Column="1"
                           Text="{Binding Gc2PerSec, StringFormat={}{0:F1}}"
                           Classes="value" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="{StaticResource PaddingSmall}"
                        Spacing="{StaticResource SpacingSmall}">
                <Border Classes="panel">
                    <StackPanel Spacing="{StaticResource SpacingSmall}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock VerticalAlignment="Center"
                                       Text="Camera"
                                       Classes="panel-title" />
                            <Button Grid.Column="1"
                                    Command="{Binding RefreshCommand}"
                                    Content="Refresh"
                                    Classes="panel-button" />
                        </Grid>
                        <TextBlock Text="Device"
                                   Classes="panel-header" />
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding Cameras}"
                                  SelectedItem="{Binding SelectedCamera}" />
                        <TextBlock Text="Resolution (YUYV)"
                                   Classes="panel-header" />
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding Resolutions}"
                                  SelectedItem="{Binding SelectedResolution}" />
                        <Button HorizontalAlignment="Stretch"
                                Command="{Binding ApplyCommand}"
                                Content="Apply"
                                Classes="panel-button" />
                        <ItemsControl ItemsSource="{Binding CameraInfo}"
                                      ItemTemplate="{StaticResource InfoItemTemplate}" />
                    </StackPanel>
                </Border>

                <Border Classes="panel">
                    <StackPanel Spacing="{StaticResource SpacingSmall}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock VerticalAlignment="Center"
                                       Text="QR code"
                                       Classes="panel-title" />
                            <CheckBox Grid.Column="1"
                                      Content="Read"
                                      IsChecked="{Binding IsQrScan}"
                                      IsEnabled="{Binding IsQrEnabled}" />
                        </Grid>
                        <TextBlock Text="{Binding QrText}"
                                   FontSize="{StaticResource FontSizeXLarge}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding QrHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding}"
                                               Classes="panel-name" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Classes="panel">
                    <StackPanel Spacing="{StaticResource SpacingSmall}">
                        <TextBlock Text="Snapshot"
                                   Classes="panel-title" />
                        <Border Height="180"
                                BorderThickness="{StaticResource BorderThicknessThin}"
                                BorderBrush="{DynamicResource PanelBorderBrush}">
                            <Image Source="{Binding LastSnapshot}"
                                   Stretch="Uniform" />
                        </Border>
                        <TextBlock Text="{Binding SnapshotText}"
                                   Classes="panel-note" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <UniformGrid Grid.Row="1" Grid.Column="0"
                     Rows="1">
            <Button Command="{Binding StartCommand}"
                    Content="Start"
                    Classes="command" />
            <Button Command="{Binding StopCommand}"
                    Content="Stop"
                    Classes="command" />
            <Button Command="{Binding SnapshotCommand}"
                    Content="Snapshot"
                    Classes="command" />
        </UniformGrid>

    </Grid>

</UserControl>
