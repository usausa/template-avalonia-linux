<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/avalonia"
             xmlns:controls="clr-namespace:Template.LinuxApp.Controls"
             xmlns:converters="clr-namespace:Template.LinuxApp.Converters"
             xmlns:video="clr-namespace:Template.LinuxApp.Components.Video"
             xmlns:module="clr-namespace:Template.LinuxApp.Views.Example"
             mc:Ignorable="d"
             x:Class="Template.LinuxApp.Views.Example.CameraView"
             x:DataType="module:CameraViewModel"
             s:DataContextResolver.Type="module:CameraViewModel"
             d:DesignWidth="1280" d:DesignHeight="740">

    <UserControl.Resources>
        <converters:CameraFormatsConverter x:Key="FormatsConverter" />
    </UserControl.Resources>

    <Grid RowDefinitions="*,Auto"
          ColumnDefinitions="*,360">

        <Viewbox Grid.Row="0" Grid.Column="0"
                 Stretch="Uniform">
            <Panel Width="{Binding FrameWidth}"
                   Height="{Binding FrameHeight}">
                <Image Source="{Binding Bitmap}"
                       Stretch="Fill" />
                <controls:FaceBoxOverlay FaceBoxes="{Binding FaceBoxes}" />
                <controls:QrCodeOverlay Stroke="{StaticResource ChartGreen}"
                                        Codes="{Binding QrCodes}" />
            </Panel>
        </Viewbox>

        <Border Grid.Row="0" Grid.Column="0"
                Margin="3" Padding="3"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Background="#40000000"
                BorderBrush="#C0FFFFFF" BorderThickness="1">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                  ColumnDefinitions="Auto,Auto">
                <Grid.Styles>
                    <Style Selector="TextBlock">
                        <Setter Property="FontFamily" Value="monospace" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Foreground" Value="White" />
                    </Style>
                    <Style Selector="TextBlock.value">
                        <Setter Property="Width" Value="36" />
                        <Setter Property="TextAlignment" Value="Right" />
                    </Style>
                </Grid.Styles>
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="FPS:" />
                <TextBlock Grid.Row="0" Grid.Column="1"
                           Classes="value"
                           Text="{Binding Fps, StringFormat={}{0:F1}}" />
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="GC0/s:" />
                <TextBlock Grid.Row="1" Grid.Column="1"
                           Classes="value"
                           Text="{Binding Gc0PerSec, StringFormat={}{0:F1}}" />
                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="GC1/s:" />
                <TextBlock Grid.Row="2" Grid.Column="1"
                           Classes="value"
                           Text="{Binding Gc1PerSec, StringFormat={}{0:F1}}" />
                <TextBlock Grid.Row="3" Grid.Column="0"
                           Text="GC2/s:" />
                <TextBlock Grid.Row="3" Grid.Column="1"
                           Classes="value"
                           Text="{Binding Gc2PerSec, StringFormat={}{0:F1}}" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                      Classes="gutter"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="{StaticResource PaddingSmall}"
                        Spacing="{StaticResource SpacingSmall}">
                <Border Classes="panel">
                    <StackPanel Spacing="{StaticResource SpacingSmall}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="panel-title"
                                       VerticalAlignment="Center"
                                       Text="Camera" />
                            <Button Grid.Column="1"
                                    Classes="panel-button"
                                    Command="{Binding RefreshCommand}"
                                    Content="Refresh" />
                        </Grid>
                        <TextBlock Classes="panel-header"
                                   Text="Device" />
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding Cameras}"
                                  SelectedItem="{Binding SelectedCamera}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="video:CameraDevice">
                                    <TextBlock>
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}  {1}">
                                                <Binding Path="Device" />
                                                <Binding Path="Name" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Classes="panel-header"
                                   Text="Resolution (YUYV)" />
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding Resolutions}"
                                  SelectedItem="{Binding SelectedResolution}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="video:CameraResolution">
                                    <TextBlock>
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} x {1}">
                                                <Binding Path="Width" />
                                                <Binding Path="Height" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Classes="panel-button"
                                HorizontalAlignment="Stretch"
                                Command="{Binding ApplyCommand}"
                                Content="Apply" />
                        <ContentControl Content="{Binding SelectedCamera}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate x:DataType="video:CameraDevice">
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                                          ColumnDefinitions="72,*">
                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Classes="panel-name"
                                                   Text="Name" />
                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                   Classes="panel-text"
                                                   Text="{Binding Name}" />
                                        <TextBlock Grid.Row="1" Grid.Column="0"
                                                   Classes="panel-name"
                                                   Text="Driver" />
                                        <TextBlock Grid.Row="1" Grid.Column="1"
                                                   Classes="panel-text"
                                                   Text="{Binding Driver}" />
                                        <TextBlock Grid.Row="2" Grid.Column="0"
                                                   Classes="panel-name"
                                                   Text="Bus" />
                                        <TextBlock Grid.Row="2" Grid.Column="1"
                                                   Classes="panel-text"
                                                   Text="{Binding BusInfo}" />
                                        <TextBlock Grid.Row="3" Grid.Column="0"
                                                   Classes="panel-name"
                                                   Text="Formats" />
                                        <TextBlock Grid.Row="3" Grid.Column="1"
                                                   Classes="panel-text"
                                                   Text="{Binding Formats, Converter={StaticResource FormatsConverter}}" />
                                    </Grid>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </StackPanel>
                </Border>

                <Border Classes="panel">
                    <StackPanel Spacing="{StaticResource SpacingSmall}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="panel-title"
                                       VerticalAlignment="Center"
                                       Text="QR code" />
                            <CheckBox Grid.Column="1"
                                      IsEnabled="{Binding IsQrEnabled}"
                                      IsChecked="{Binding IsQrScan}"
                                      Content="Read" />
                        </Grid>
                        <TextBlock TextWrapping="Wrap"
                                   Text="{Binding QrText, TargetNullValue=—}"
                                   FontSize="{StaticResource FontSizeXLarge}"
                                   FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding QrHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="module:QrHistoryItem">
                                    <TextBlock Classes="panel-name">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0:HH:mm:ss}  {1}">
                                                <Binding Path="Time" />
                                                <Binding Path="Text" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Classes="panel">
                    <StackPanel Spacing="{StaticResource SpacingSmall}">
                        <TextBlock Classes="panel-title"
                                   Text="Snapshot" />
                        <Border Height="180"
                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="{StaticResource BorderThicknessThin}">
                            <Image Source="{Binding LastSnapshot}"
                                   Stretch="Uniform" />
                        </Border>
                        <TextBlock Classes="panel-note"
                                   IsVisible="{Binding SnapshotFile, Converter={x:Static ObjectConverters.IsNull}}"
                                   Text="{Binding SnapshotFolder}" />
                        <TextBlock Classes="panel-note"
                                   IsVisible="{Binding SnapshotFile, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} ({1})">
                                    <Binding Path="SnapshotFile" />
                                    <Binding Path="SnapshotCount" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Classes="panel-note"
                                   IsVisible="{Binding SnapshotError, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   Text="{Binding SnapshotError}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <UniformGrid Grid.Row="1" Grid.Column="0"
                     Rows="1">
            <Button Classes="command"
                    Command="{Binding StartCommand}"
                    Content="Start" />
            <Button Classes="command"
                    Command="{Binding StopCommand}"
                    Content="Stop" />
            <Button Classes="command"
                    Command="{Binding SnapshotCommand}"
                    Content="Snapshot" />
        </UniformGrid>

    </Grid>

</UserControl>
