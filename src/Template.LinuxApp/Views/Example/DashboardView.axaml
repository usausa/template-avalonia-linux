<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/avalonia"
             xmlns:sys="using:System"
             xmlns:local="clr-namespace:Template.LinuxApp.Views.Example"
             xmlns:controls="clr-namespace:Template.LinuxApp.Controls"
             mc:Ignorable="d"
             x:Class="Template.LinuxApp.Views.Example.DashboardView"
             x:DataType="local:DashboardViewModel"
             s:DataContextResolver.Type="local:DashboardViewModel"
             d:DesignWidth="1280" d:DesignHeight="740">

    <UserControl.Styles>
        <Style Selector="TextBlock.dashboard-name">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="Foreground" Value="{DynamicResource PanelNoteBrush}" />
        </Style>
        <Style Selector="TextBlock.dashboard-value">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="32" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="controls|RingGauge">
            <Setter Property="MaxWidth" Value="400" />
            <Setter Property="MaxHeight" Value="400" />
            <Setter Property="Thickness" Value="24" />
            <Setter Property="Foreground" Value="{DynamicResource PanelNoteBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*"
          ColumnDefinitions="3*,2*"
          Margin="{StaticResource PaddingSmall}"
          ColumnSpacing="{StaticResource SpacingSmall}"
          RowSpacing="{StaticResource SpacingSmall}">

        <Border Grid.Row="0" Grid.Column="0"
                Classes="panel">
            <StackPanel>
                <TextBlock Margin="0,0,0,8"
                           Text="Application"
                           Classes="title" />
                <Grid ColumnDefinitions="220,*"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                      RowSpacing="{StaticResource SpacingXSmall}">
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="Version"
                               Classes="dashboard-name" />
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Text="{Binding Version, TargetNullValue=—}"
                               Classes="dashboard-value" />
                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="Runtime"
                               Classes="dashboard-name" />
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Classes="dashboard-value">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} {1}">
                                <Binding Path="Framework" />
                                <Binding Path="RuntimeIdentifier" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Text="Environment"
                               Classes="dashboard-name" />
                    <TextBlock Grid.Row="2" Grid.Column="1"
                               Classes="dashboard-value">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} (setting {1})">
                                <Binding Path="EnvironmentName" />
                                <Binding Path="SettingValue" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Grid.Row="3" Grid.Column="0"
                               Text="Kiosk"
                               Classes="dashboard-name" />
                    <TextBlock Grid.Row="3" Grid.Column="1"
                               Text="{Binding IsKiosk, Converter={s:BoolToText True=Enabled, False=Disabled}}"
                               Classes="dashboard-value" />
                    <TextBlock Grid.Row="4" Grid.Column="0"
                               Text="Process"
                               Classes="dashboard-name" />
                    <TextBlock Grid.Row="4" Grid.Column="1"
                               Text="{Binding ProcessId, StringFormat='PID {0}'}"
                               Classes="dashboard-value" />
                    <TextBlock Grid.Row="5" Grid.Column="0"
                               Text="Started"
                               Classes="dashboard-name" />
                    <TextBlock Grid.Row="5" Grid.Column="1"
                               Text="{Binding StartTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"
                               Classes="dashboard-value" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="0" Grid.Column="1"
                Classes="panel">
            <StackPanel Spacing="{StaticResource SpacingSmall}">
                <TextBlock Text="Theme"
                           Classes="title" />
                <UniformGrid Columns="3"
                             ColumnSpacing="{StaticResource SpacingSmall}">
                    <Button Command="{Binding ThemeCommand}"
                            CommandParameter="Light"
                            Content="Light"
                            Classes="command" />
                    <Button Command="{Binding ThemeCommand}"
                            CommandParameter="Dark"
                            Content="Dark"
                            Classes="command" />
                    <Button Command="{Binding ThemeCommand}"
                            CommandParameter="System"
                            Content="System"
                            Classes="command" />
                </UniformGrid>
                <TextBlock Margin="0,16,0,0"
                           Text="Actions"
                           Classes="title" />
                <Button Command="{Binding ExitCommand}"
                        Content="Exit"
                        Classes="command" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                Classes="panel">
            <Grid RowDefinitions="Auto,*"
                  RowSpacing="{StaticResource SpacingSmall}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Status"
                               Classes="title" />
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               IsVisible="{Binding !IsSupported}"
                               Text="System information is available on Linux."
                               Classes="dashboard-name" />
                </Grid>
                <UniformGrid Grid.Row="1"
                             Rows="1"
                             ColumnSpacing="{StaticResource SpacingSmall}">
                    <controls:RingGauge Value="{Binding Cpu, TargetNullValue={x:Static sys:Double.NaN}}"
                                        Text="{Binding Cpu, StringFormat='{}{0:F0}%', TargetNullValue=—}"
                                        Label="CPU"
                                        Fill="{StaticResource ChartBlue}" />
                    <controls:RingGauge Value="{Binding Memory, TargetNullValue={x:Static sys:Double.NaN}}"
                                        Text="{Binding Memory, StringFormat='{}{0:F0}%', TargetNullValue=—}"
                                        Label="Memory"
                                        Fill="{StaticResource ChartPurple}" />
                    <controls:RingGauge Value="{Binding Swap, TargetNullValue={x:Static sys:Double.NaN}}"
                                        Text="{Binding Swap, StringFormat='{}{0:F0}%', TargetNullValue=—}"
                                        Label="Swap"
                                        Fill="{StaticResource ChartOrange}" />
                    <controls:RingGauge Value="{Binding Temperature, TargetNullValue={x:Static sys:Double.NaN}}"
                                        Text="{Binding Temperature, StringFormat='{}{0:F0} °C', TargetNullValue=—}"
                                        Label="Temperature"
                                        Fill="{StaticResource ChartRed}" />
                </UniformGrid>
            </Grid>
        </Border>

    </Grid>

</UserControl>
