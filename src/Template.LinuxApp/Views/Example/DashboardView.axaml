<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/avalonia"
             xmlns:local="clr-namespace:Template.LinuxApp.Views.Example"
             xmlns:controls="clr-namespace:Template.LinuxApp.Controls"
             mc:Ignorable="d"
             x:Class="Template.LinuxApp.Views.Example.DashboardView"
             x:DataType="local:DashboardViewModel"
             s:DataContextResolver.Type="local:DashboardViewModel"
             d:DesignWidth="1280" d:DesignHeight="740">

    <UserControl.Styles>
        <Style Selector="TextBlock.dashboard-name">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="Foreground" Value="{DynamicResource PanelNoteBrush}" />
        </Style>
        <Style Selector="TextBlock.dashboard-value">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="32" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="controls|RingGauge">
            <Setter Property="MaxWidth" Value="400" />
            <Setter Property="MaxHeight" Value="400" />
            <Setter Property="Thickness" Value="24" />
            <Setter Property="Foreground" Value="{DynamicResource PanelNoteBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*"
          ColumnDefinitions="3*,2*"
          Margin="{StaticResource PaddingSmall}"
          ColumnSpacing="{StaticResource SpacingSmall}"
          RowSpacing="{StaticResource SpacingSmall}">

        <Border Grid.Row="0" Grid.Column="0"
                Classes="panel">
            <StackPanel>
                <TextBlock Margin="0,0,0,8"
                           Text="Application"
                           Classes="title" />
                <ItemsControl ItemsSource="{Binding Application}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="{StaticResource SpacingXSmall}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:InfoItem">
                            <Grid ColumnDefinitions="220,*">
                                <TextBlock Text="{Binding Name}"
                                           Classes="dashboard-name" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Value}"
                                           Classes="dashboard-value" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Grid.Row="0" Grid.Column="1"
                Classes="panel">
            <StackPanel Spacing="{StaticResource SpacingSmall}">
                <TextBlock Text="Theme"
                           Classes="title" />
                <UniformGrid Columns="3"
                             ColumnSpacing="{StaticResource SpacingSmall}">
                    <Button Command="{Binding ThemeCommand}"
                            CommandParameter="Light"
                            Content="Light"
                            Classes="command" />
                    <Button Command="{Binding ThemeCommand}"
                            CommandParameter="Dark"
                            Content="Dark"
                            Classes="command" />
                    <Button Command="{Binding ThemeCommand}"
                            CommandParameter="System"
                            Content="System"
                            Classes="command" />
                </UniformGrid>
                <TextBlock Margin="0,16,0,0"
                           Text="Actions"
                           Classes="title" />
                <Button Command="{Binding ExitCommand}"
                        Content="Exit"
                        Classes="command" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                Classes="panel">
            <Grid RowDefinitions="Auto,*"
                  RowSpacing="{StaticResource SpacingSmall}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Status"
                               Classes="title" />
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               IsVisible="{Binding !IsSupported}"
                               Text="System information is available on Linux."
                               Classes="dashboard-name" />
                </Grid>
                <UniformGrid Grid.Row="1"
                             Rows="1"
                             ColumnSpacing="{StaticResource SpacingSmall}">
                    <controls:RingGauge Value="{Binding Cpu.Value}"
                                        Text="{Binding Cpu.Text}"
                                        Label="CPU"
                                        Fill="{StaticResource ChartBlue}" />
                    <controls:RingGauge Value="{Binding Memory.Value}"
                                        Text="{Binding Memory.Text}"
                                        Label="Memory"
                                        Fill="{StaticResource ChartPurple}" />
                    <controls:RingGauge Value="{Binding Swap.Value}"
                                        Text="{Binding Swap.Text}"
                                        Label="Swap"
                                        Fill="{StaticResource ChartOrange}" />
                    <controls:RingGauge Value="{Binding Temperature.Value}"
                                        Text="{Binding Temperature.Text}"
                                        Label="Temperature"
                                        Fill="{StaticResource ChartRed}" />
                </UniformGrid>
            </Grid>
        </Border>

    </Grid>

</UserControl>
