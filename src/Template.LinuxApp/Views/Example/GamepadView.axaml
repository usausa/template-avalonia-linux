<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/avalonia"
             xmlns:controls="clr-namespace:Template.LinuxApp.Controls"
             xmlns:module="clr-namespace:Template.LinuxApp.Views.Example"
             mc:Ignorable="d"
             x:Class="Template.LinuxApp.Views.Example.GamepadView"
             x:DataType="module:GamepadViewModel"
             s:DataContextResolver.Type="module:GamepadViewModel"
             d:DesignWidth="1280" d:DesignHeight="696">

    <UserControl.Resources>
        <controls:ChartColorCollection x:Key="FaceColors">
            <StaticResource ResourceKey="ChartGreen" />
            <StaticResource ResourceKey="ChartRed" />
            <StaticResource ResourceKey="ChartBlue" />
            <StaticResource ResourceKey="ChartYellow" />
        </controls:ChartColorCollection>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.button-cell">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="BorderThickness" Value="{StaticResource BorderThicknessThin}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
        </Style>
        <Style Selector="Border.button-cell.pressed">
            <Setter Property="Background" Value="{StaticResource ChartBlue}" />
            <Setter Property="BorderBrush" Value="{StaticResource ChartBlue}" />
        </Style>
        <Style Selector="Border.button-cell.pressed TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="controls|AxisBar">
            <Setter Property="Height" Value="12" />
            <Setter Property="Fill" Value="{StaticResource ChartBlue}" />
            <Setter Property="TrackBrush" Value="{DynamicResource PanelBorderBrush}" />
        </Style>
        <Style Selector="controls|StickScope">
            <Setter Property="Fill" Value="{StaticResource ChartGreen}" />
            <Setter Property="OutsideFill" Value="{StaticResource ChartOrange}" />
            <Setter Property="Stroke" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PanelNoteBrush}" />
        </Style>
        <Style Selector="TextBlock.stick-state">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{StaticResource ChartGreen}" />
        </Style>
        <Style Selector="TextBlock.stick-state.outside">
            <Setter Property="Foreground" Value="{StaticResource ChartOrange}" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="2*,*"
          Margin="{StaticResource PaddingSmall}"
          ColumnSpacing="{StaticResource SpacingSmall}">

        <Border Grid.Column="0"
                Classes="panel">
            <DockPanel>
                <Grid ColumnDefinitions="*,Auto"
                      DockPanel.Dock="Top">
                    <TextBlock Text="Controller"
                               Classes="panel-title" />
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="{StaticResource SpacingSmall}">
                        <TextBlock IsVisible="{Binding IsConnected}"
                                   Text="{Binding DeviceName}"
                                   Classes="panel-name" />
                        <TextBlock IsVisible="{Binding !IsConnected}"
                                   Text="Disconnected"
                                   Classes="panel-name" />
                        <TextBlock Text="{Binding Device}"
                                   Classes="panel-name" />
                    </StackPanel>
                </Grid>
                <controls:GamepadDiagram Margin="{StaticResource PaddingLarge}"
                                         Stroke="{DynamicResource PanelNoteBrush}"
                                         Axes="{Binding Axes}"
                                         BodyFill="{DynamicResource PanelBorderBrush}"
                                         Buttons="{Binding Buttons}"
                                         FaceColors="{StaticResource FaceColors}"
                                         Foreground="{DynamicResource PanelTitleBrush}"
                                         IsConnected="{Binding IsConnected}"
                                         PressedFill="{StaticResource ChartBlue}" />
            </DockPanel>
        </Border>

        <Grid Grid.Column="1"
              RowDefinitions="Auto,Auto,2*,3*"
              RowSpacing="{StaticResource SpacingSmall}">

            <Border Grid.Row="0"
                    Classes="panel">
                <StackPanel Spacing="{StaticResource SpacingSmall}">
                    <TextBlock Text="Buttons"
                               Classes="panel-title" />
                    <ItemsControl ItemsSource="{Binding ButtonItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid RowSpacing="{StaticResource SpacingXSmall}"
                                             ColumnSpacing="{StaticResource SpacingXSmall}"
                                             Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="module:GamepadButtonItem">
                                <Border Classes="button-cell"
                                        Classes.pressed="{Binding Pressed}">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Text="{Binding Index}"
                                                   Classes="panel-name" />
                                        <TextBlock Grid.Column="1"
                                                   HorizontalAlignment="Right"
                                                   Text="{Binding Name}"
                                                   Classes="panel-text" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Grid.Row="1"
                    Classes="panel">
                <StackPanel Spacing="{StaticResource SpacingSmall}">
                    <TextBlock Text="Axes"
                               Classes="panel-title" />
                    <ItemsControl ItemsSource="{Binding AxisItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="{StaticResource SpacingXSmall}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="module:GamepadAxisItem">
                                <Grid ColumnDefinitions="20,64,*,56"
                                      ColumnSpacing="{StaticResource SpacingSmall}">
                                    <TextBlock Text="{Binding Index}"
                                               Classes="panel-name" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Name}"
                                               Classes="panel-text" />
                                    <controls:AxisBar Grid.Column="2"
                                                      Value="{Binding Value}" />
                                    <TextBlock Grid.Column="3"
                                               HorizontalAlignment="Right"
                                               Text="{Binding Raw}"
                                               Classes="panel-text" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    Classes="panel">
                <DockPanel>
                    <TextBlock Margin="0,0,0,6"
                               Text="Sticks"
                               Classes="panel-title" DockPanel.Dock="Top" />
                    <ItemsControl ItemsSource="{Binding StickItems}"
                                  ClipToBounds="True">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid ColumnSpacing="{StaticResource SpacingSmall}"
                                             Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="module:GamepadStickItem">
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="{StaticResource SpacingSmall}">
                                    <controls:StickScope Deadzone="{x:Static module:GamepadViewModel.Deadzone}"
                                                         Position="{Binding Position}" />
                                    <Grid Grid.Column="1"
                                          RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                          ColumnDefinitions="Auto,64"
                                          RowSpacing="{StaticResource SpacingXSmall}"
                                          ColumnSpacing="{StaticResource SpacingSmall}"
                                          VerticalAlignment="Center">
                                        <TextBlock Grid.ColumnSpan="2"
                                                   Text="{Binding Name}"
                                                   Classes="panel-title" />
                                        <TextBlock Grid.Row="1" Grid.Column="0"
                                                   Text="X"
                                                   Classes="panel-name" />
                                        <TextBlock Grid.Row="1" Grid.Column="1"
                                                   HorizontalAlignment="Right"
                                                   Text="{Binding X, StringFormat='{}{0:+0.0%;-0.0%;0.0%}'}"
                                                   Classes="panel-text" />
                                        <TextBlock Grid.Row="2" Grid.Column="0"
                                                   Text="Y"
                                                   Classes="panel-name" />
                                        <TextBlock Grid.Row="2" Grid.Column="1"
                                                   HorizontalAlignment="Right"
                                                   Text="{Binding Y, StringFormat='{}{0:+0.0%;-0.0%;0.0%}'}"
                                                   Classes="panel-text" />
                                        <TextBlock Grid.Row="3" Grid.Column="0"
                                                   Text="Offset"
                                                   Classes="panel-name" />
                                        <TextBlock Grid.Row="3" Grid.Column="1"
                                                   HorizontalAlignment="Right"
                                                   Text="{Binding Offset, StringFormat='{}{0:0.0%}'}"
                                                   Classes="panel-text" />
                                        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                                   Text="{Binding IsOutside, Converter={s:BoolToText True='Outside deadzone', False='Inside deadzone'}}"
                                                   Classes="stick-state"
                                                   Classes.outside="{Binding IsOutside}" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <Border Grid.Row="3"
                    Classes="panel">
                <DockPanel>
                    <TextBlock Margin="0,0,0,6"
                               Text="Events"
                               Classes="panel-title" DockPanel.Dock="Top" />
                    <ItemsControl ItemsSource="{Binding Events}"
                                  ClipToBounds="True">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="module:GamepadEventItem">
                                <TextBlock Classes="panel-text">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0:HH:mm:ss.fff}  {1}">
                                            <Binding Path="Time" />
                                            <Binding Path="Message" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>

</UserControl>
