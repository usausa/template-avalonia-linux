<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/avalonia"
             xmlns:local="clr-namespace:Template.LinuxApp.Views.Example"
             xmlns:controls="clr-namespace:Template.LinuxApp.Controls"
             mc:Ignorable="d"
             x:Class="Template.LinuxApp.Views.Example.GraphicsView"
             x:DataType="local:GraphicsViewModel"
             s:DataContextResolver.Type="local:GraphicsViewModel"
             d:DesignWidth="1280" d:DesignHeight="696">

    <UserControl.Styles>
        <Style Selector="TextBlock.caption">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeMedium}" />
            <Setter Property="Foreground" Value="{DynamicResource PanelNoteBrush}" />
        </Style>
        <Style Selector="TextBlock.easing-name">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeMedium}" />
            <Setter Property="Foreground" Value="{DynamicResource PanelNoteBrush}" />
        </Style>
        <Style Selector="Rectangle.rotate">
            <Style.Animations>
                <Animation Duration="0:0:3"
                           IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.translate">
            <Style.Animations>
                <Animation Duration="0:0:1.2"
                           Easing="SineEaseInOut" IterationCount="INFINITE" PlaybackDirection="Alternate">
                    <KeyFrame Cue="0%">
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="TranslateTransform.Y" Value="-120" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.scale">
            <Style.Animations>
                <Animation Duration="0:0:1.6"
                           Easing="SineEaseInOut" IterationCount="INFINITE" PlaybackDirection="Alternate">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="0.4" />
                        <Setter Property="ScaleTransform.ScaleY" Value="0.4" />
                        <Setter Property="Opacity" Value="0.3" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.easing">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Ellipse.linear">
            <Style.Animations>
                <Animation Duration="0:0:2"
                           IterationCount="INFINITE" PlaybackDirection="Alternate">
                    <KeyFrame Cue="0%">
                        <Setter Property="TranslateTransform.X" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="TranslateTransform.X" Value="240" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.sine">
            <Style.Animations>
                <Animation Duration="0:0:2"
                           Easing="SineEaseInOut" IterationCount="INFINITE" PlaybackDirection="Alternate">
                    <KeyFrame Cue="0%">
                        <Setter Property="TranslateTransform.X" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="TranslateTransform.X" Value="240" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.cubic">
            <Style.Animations>
                <Animation Duration="0:0:2"
                           Easing="CubicEaseInOut" IterationCount="INFINITE" PlaybackDirection="Alternate">
                    <KeyFrame Cue="0%">
                        <Setter Property="TranslateTransform.X" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="TranslateTransform.X" Value="240" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.back">
            <Style.Animations>
                <Animation Duration="0:0:2"
                           Easing="BackEaseOut" IterationCount="INFINITE" PlaybackDirection="Alternate">
                    <KeyFrame Cue="0%">
                        <Setter Property="TranslateTransform.X" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="TranslateTransform.X" Value="240" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.bounce">
            <Style.Animations>
                <Animation Duration="0:0:2"
                           Easing="BounceEaseOut" IterationCount="INFINITE" PlaybackDirection="Alternate">
                    <KeyFrame Cue="0%">
                        <Setter Property="TranslateTransform.X" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="TranslateTransform.X" Value="240" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.elastic">
            <Style.Animations>
                <Animation Duration="0:0:2"
                           Easing="ElasticEaseOut" IterationCount="INFINITE" PlaybackDirection="Alternate">
                    <KeyFrame Cue="0%">
                        <Setter Property="TranslateTransform.X" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="TranslateTransform.X" Value="240" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="4*,5*"
          Margin="{StaticResource PaddingSmall}"
          RowSpacing="{StaticResource SpacingSmall}">

        <Grid Grid.Row="0"
              ColumnDefinitions="*,*,*,*"
              ColumnSpacing="{StaticResource SpacingSmall}">
            <Border Grid.Column="0"
                    Classes="panel">
                <Grid RowDefinitions="Auto,*,Auto"
                      ColumnDefinitions="*,*,*">
                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                               Text="Animation"
                               Classes="panel-title" />
                    <Rectangle Grid.Row="1" Grid.Column="0"
                               Width="72" Height="72"
                               Classes="rotate"
                               Fill="{StaticResource ChartGreen}" />
                    <Ellipse Grid.Row="1" Grid.Column="1"
                             Width="44" Height="44"
                             Margin="0,0,0,8"
                             VerticalAlignment="Bottom"
                             Classes="translate"
                             Fill="{StaticResource ChartOrange}" />
                    <Ellipse Grid.Row="1" Grid.Column="2"
                             Width="88" Height="88"
                             Classes="scale"
                             Fill="{StaticResource ChartPurple}" />
                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Text="Rotate"
                               Classes="caption" />
                    <TextBlock Grid.Row="2" Grid.Column="1"
                               Text="Translate"
                               Classes="caption" />
                    <TextBlock Grid.Row="2" Grid.Column="2"
                               Text="Scale"
                               Classes="caption" />
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Classes="panel">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0"
                               Text="Easing"
                               Classes="panel-title" />
                    <UniformGrid Grid.Row="1"
                                 Columns="1">
                        <Grid ColumnDefinitions="96,*">
                            <TextBlock Text="Linear"
                                       Classes="easing-name" />
                            <Ellipse Grid.Column="1"
                                     Classes="easing linear"
                                     Fill="{StaticResource ChartBlue}" />
                        </Grid>
                        <Grid ColumnDefinitions="96,*">
                            <TextBlock Text="Sine"
                                       Classes="easing-name" />
                            <Ellipse Grid.Column="1"
                                     Classes="easing sine"
                                     Fill="{StaticResource ChartGreen}" />
                        </Grid>
                        <Grid ColumnDefinitions="96,*">
                            <TextBlock Text="Cubic"
                                       Classes="easing-name" />
                            <Ellipse Grid.Column="1"
                                     Classes="easing cubic"
                                     Fill="{StaticResource ChartYellow}" />
                        </Grid>
                        <Grid ColumnDefinitions="96,*">
                            <TextBlock Text="Back"
                                       Classes="easing-name" />
                            <Ellipse Grid.Column="1"
                                     Classes="easing back"
                                     Fill="{StaticResource ChartOrange}" />
                        </Grid>
                        <Grid ColumnDefinitions="96,*">
                            <TextBlock Text="Bounce"
                                       Classes="easing-name" />
                            <Ellipse Grid.Column="1"
                                     Classes="easing bounce"
                                     Fill="{StaticResource ChartRed}" />
                        </Grid>
                        <Grid ColumnDefinitions="96,*">
                            <TextBlock Text="Elastic"
                                       Classes="easing-name" />
                            <Ellipse Grid.Column="1"
                                     Classes="easing elastic"
                                     Fill="{StaticResource ChartPurple}" />
                        </Grid>
                    </UniformGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Classes="panel">
                <Grid RowDefinitions="Auto,*,Auto"
                      RowSpacing="{StaticResource SpacingXSmall}">
                    <TextBlock Grid.Row="0"
                               Text="Clock"
                               Classes="panel-title" />
                    <controls:AnalogClock Grid.Row="1"
                                          DialBrush="{DynamicResource PanelNoteBrush}"
                                          HandBrush="{DynamicResource PanelTitleBrush}"
                                          SecondHandBrush="{StaticResource ChartRed}"
                                          Time="{Binding Time}" />
                    <TextBlock Grid.Row="2"
                               HorizontalAlignment="Center"
                               Text="{Binding TimeText}"
                               FontFamily="{StaticResource Dseg7}"
                               FontSize="36"
                               Foreground="{DynamicResource PanelTitleBrush}" />
                </Grid>
            </Border>

            <Border Grid.Column="3"
                    Classes="panel">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0"
                               Text="Shapes"
                               Classes="panel-title" />
                    <UniformGrid Grid.Row="1"
                                 Columns="3" Rows="2">
                        <Rectangle Width="100" Height="64">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                    <GradientStop Offset="0" Color="{StaticResource ChartBlueDark}" />
                                    <GradientStop Offset="1" Color="{StaticResource ChartBlueSuperLight}" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Ellipse Width="84" Height="84">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Offset="0" Color="{StaticResource ChartYellowLight}" />
                                    <GradientStop Offset="1" Color="{StaticResource ChartOrangeDark}" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse Width="84" Height="84">
                            <Ellipse.Fill>
                                <ConicGradientBrush>
                                    <GradientStop Offset="0" Color="{StaticResource ChartRed}" />
                                    <GradientStop Offset="0.2" Color="{StaticResource ChartOrange}" />
                                    <GradientStop Offset="0.4" Color="{StaticResource ChartYellow}" />
                                    <GradientStop Offset="0.6" Color="{StaticResource ChartGreen}" />
                                    <GradientStop Offset="0.8" Color="{StaticResource ChartBlue}" />
                                    <GradientStop Offset="1" Color="{StaticResource ChartRed}" />
                                </ConicGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Path Width="84" Height="80"
                              Data="M 28,0 L 34.6,19.9 55.6,20 38.6,32.4 45,52.4 28,40.1 11,52.4 17.4,32.4 0.4,20 21.4,19.9 Z"
                              Fill="{StaticResource ChartRed}"
                              Stretch="Uniform" />
                        <Viewbox Width="100" Height="64">
                            <Polyline Points="0,36 16,8 32,36 48,8 64,36"
                                      Stroke="{StaticResource ChartGreen}"
                                      StrokeDashArray="2,1.5" StrokeJoin="Round" StrokeLineCap="Round" StrokeThickness="4" />
                        </Viewbox>
                        <Border Width="100" Height="64"
                                Background="{DynamicResource PanelBackgroundBrush}"
                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="{StaticResource BorderThicknessThin}"
                                CornerRadius="{StaticResource CornerRadiusSmall}"
                                BoxShadow="0 6 16 0 #66000000" />
                    </UniformGrid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,*"
              ColumnSpacing="{StaticResource SpacingSmall}">
            <Border Grid.Column="0"
                    Classes="panel">
                <Grid RowDefinitions="Auto,*"
                      RowSpacing="{StaticResource SpacingXSmall}">
                    <Grid Grid.Row="0"
                          ColumnDefinitions="Auto,*"
                          ColumnSpacing="{StaticResource SpacingMedium}">
                        <TextBlock Text="Particles"
                                   Classes="panel-title" />
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="120 particles, linked within 110 px, moved on every frame"
                                   Classes="panel-note" />
                    </Grid>
                    <controls:ParticleField Grid.Row="1"
                                            ClipToBounds="True"
                                            Fill="{StaticResource ChartBlue}"
                                            LinkBrush="{StaticResource ChartBlue}" />
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Classes="panel">
                <Grid RowDefinitions="Auto,*"
                      RowSpacing="{StaticResource SpacingXSmall}">
                    <Grid Grid.Row="0"
                          ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="{StaticResource SpacingMedium}">
                        <TextBlock Text="Wave"
                                   Classes="panel-title" />
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="Redrawn on every frame (RequestAnimationFrame)"
                                   Classes="panel-note" />
                        <controls:FrameRateCounter Grid.Column="2"
                                                   VerticalAlignment="Center"
                                                   FontSize="{StaticResource FontSizeLarge}"
                                                   Foreground="{DynamicResource PanelNoteBrush}" />
                    </Grid>
                    <controls:AnimatedWave Grid.Row="1"
                                           GridBrush="{DynamicResource PanelBorderBrush}"
                                           Stroke="{StaticResource ChartBlue}"
                                           SecondaryStroke="{StaticResource ChartOrange}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>

</UserControl>
