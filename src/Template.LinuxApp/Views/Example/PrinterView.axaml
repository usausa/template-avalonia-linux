<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:cups="using:LinuxDotNet.Cups"
             xmlns:s="http://smart/avalonia"
             xmlns:controls="clr-namespace:Template.LinuxApp.Controls"
             xmlns:module="clr-namespace:Template.LinuxApp.Views.Example"
             mc:Ignorable="d"
             x:Class="Template.LinuxApp.Views.Example.PrinterView"
             x:DataType="module:PrinterViewModel"
             s:DataContextResolver.Type="module:PrinterViewModel"
             d:DesignWidth="1280" d:DesignHeight="740">

    <UserControl.Resources>
        <s:MapToBrushConverter x:Key="PrinterStateBrushConverter"
                               DefaultValue="Gray">
            <s:MapToBrushConverter.Entries>
                <s:MapToBrushEntry Key="{x:Static cups:PrinterState.Idle}"
                                   Value="{StaticResource ChartGreen}" />
                <s:MapToBrushEntry Key="{x:Static cups:PrinterState.Processing}"
                                   Value="{StaticResource ChartBlue}" />
                <s:MapToBrushEntry Key="{x:Static cups:PrinterState.Stopped}"
                                   Value="{StaticResource ChartRed}" />
            </s:MapToBrushConverter.Entries>
        </s:MapToBrushConverter>
        <s:MapToBrushConverter x:Key="JobStateBrushConverter"
                               DefaultValue="Gray">
            <s:MapToBrushConverter.Entries>
                <s:MapToBrushEntry Key="{x:Static cups:PrintJobState.Processing}"
                                   Value="{StaticResource ChartBlue}" />
                <s:MapToBrushEntry Key="{x:Static cups:PrintJobState.Held}"
                                   Value="{StaticResource ChartYellow}" />
                <s:MapToBrushEntry Key="{x:Static cups:PrintJobState.Stopped}"
                                   Value="{StaticResource ChartOrange}" />
                <s:MapToBrushEntry Key="{x:Static cups:PrintJobState.Aborted}"
                                   Value="{StaticResource ChartRed}" />
                <s:MapToBrushEntry Key="{x:Static cups:PrintJobState.Completed}"
                                   Value="{StaticResource ChartGreen}" />
            </s:MapToBrushConverter.Entries>
        </s:MapToBrushConverter>
        <s:MapToTextConverter x:Key="ResultTextConverter">
            <s:MapToTextConverter.Entries>
                <s:MapToTextEntry Key="{x:Static module:PrintResult.TextSent}"
                                  Value="Sent to the line printer" />
                <s:MapToTextEntry Key="{x:Static module:PrintResult.TextFailed}"
                                  Value="Printing to the line printer failed" />
                <s:MapToTextEntry Key="{x:Static module:PrintResult.ImageSent}"
                                  Value="Sent to the image printer" />
                <s:MapToTextEntry Key="{x:Static module:PrintResult.ImageFailed}"
                                  Value="Printing to the image printer failed" />
                <s:MapToTextEntry Key="{x:Static module:PrintResult.Canceled}"
                                  Value="Canceled" />
                <s:MapToTextEntry Key="{x:Static module:PrintResult.CancelFailed}"
                                  Value="Canceling failed" />
            </s:MapToTextConverter.Entries>
        </s:MapToTextConverter>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.state-chip">
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.state-chip > TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Border.paper">
            <Setter Property="Padding" Value="{StaticResource PaddingNormal}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="{StaticResource BorderThicknessThin}" />
        </Style>
        <Style Selector="TextBlock.result">
            <Setter Property="FontSize" Value="{StaticResource FontSizeLarge}" />
            <Setter Property="Foreground" Value="{DynamicResource PanelNoteBrush}" />
        </Style>
        <Style Selector="TextBlock.result.error">
            <Setter Property="Foreground" Value="{StaticResource ChartRed}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto"
          ColumnDefinitions="*,480"
          Margin="{StaticResource PaddingSmall}"
          RowSpacing="{StaticResource SpacingSmall}"
          ColumnSpacing="{StaticResource SpacingSmall}">

        <Grid Grid.Row="0" Grid.Column="0"
              ColumnDefinitions="*,*"
              ColumnSpacing="{StaticResource SpacingSmall}">
            <controls:DeviceCard Grid.Column="0"
                                 Title="Line printer"
                                 Device="{Binding LineDevice}"
                                 Status="{Binding LineStatus}" />
            <controls:DeviceCard Grid.Column="1"
                                 Title="Image printer"
                                 Device="{Binding ImageDevice}"
                                 Status="{Binding ImageStatus}" />
        </Grid>

        <Border Grid.Row="1" Grid.Column="0"
                Classes="panel">
            <Grid RowDefinitions="Auto,*,Auto"
                  ColumnDefinitions="*,*"
                  RowSpacing="{StaticResource SpacingSmall}"
                  ColumnSpacing="{StaticResource SpacingNormal}">
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Classes="card-note"
                           Text="Line printer" />
                <TextBlock Grid.Row="0" Grid.Column="1"
                           Classes="card-note"
                           Text="Image printer" />
                <Border Grid.Row="1" Grid.Column="0"
                        Classes="paper"
                        Padding="40,24"
                        VerticalAlignment="Top">
                    <Viewbox Stretch="Uniform">
                        <TextBlock Text="{Binding PreviewText}"
                                   FontFamily="monospace"
                                   Foreground="Black" />
                    </Viewbox>
                </Border>
                <Border Grid.Row="1" Grid.Column="1"
                        Classes="paper"
                        Padding="0"
                        HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Image Source="{Binding PreviewImage}"
                           Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            Spacing="{StaticResource SpacingNormal}"
                            IsVisible="{Binding HasResult}">
                    <TextBlock Classes="result"
                               Classes.error="{Binding IsResultError}"
                               Text="{Binding ResultTime, StringFormat='{}{0:HH:mm:ss}'}" />
                    <TextBlock Classes="result"
                               Classes.error="{Binding IsResultError}"
                               Text="{Binding Result, Converter={StaticResource ResultTextConverter}}" />
                    <TextBlock Classes="result"
                               Classes.error="{Binding IsResultError}"
                               IsVisible="{Binding ResultJobId, Converter={x:Static ObjectConverters.IsNotNull}}"
                               Text="{Binding ResultJobId, StringFormat='#{0}'}" />
                </StackPanel>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="2" Grid.Column="0"
                     Rows="1">
            <Button Classes="command"
                    Command="{Binding PrintTextCommand}"
                    Content="Print text" />
            <Button Classes="command"
                    Command="{Binding PrintImageCommand}"
                    Content="Print image" />
        </UniformGrid>

        <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="1"
                Classes="panel">
            <Grid RowDefinitions="Auto,Auto,*"
                  RowSpacing="{StaticResource SpacingSmall}">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="{StaticResource SpacingNormal}">
                    <TextBlock Classes="card-title"
                               Text="Jobs" />
                    <Border Grid.Column="1"
                            Classes="state-chip"
                            Background="{Binding Queue.State, Converter={StaticResource PrinterStateBrushConverter}}">
                        <TextBlock Text="{Binding Queue.State}"
                                   FontSize="{StaticResource FontSizeLarge}" />
                    </Border>
                </Grid>
                <WrapPanel Grid.Row="1"
                           ItemSpacing="{StaticResource SpacingNormal}">
                    <TextBlock Classes="card-meta"
                               IsVisible="{Binding Queue.MakeModel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Text="{Binding Queue.MakeModel}" />
                    <TextBlock Classes="card-meta"
                               IsVisible="{Binding Queue.Reasons, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Text="{Binding Queue.Reasons}" />
                    <TextBlock Classes="card-meta"
                               IsVisible="{Binding Queue.Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Text="{Binding Queue.Message}" />
                    <TextBlock Classes="card-meta"
                               IsVisible="{Binding !Queue.IsAcceptingJobs}"
                               Text="Not accepting jobs" />
                </WrapPanel>
                <TextBlock Grid.Row="2"
                           Classes="card-note"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="{Binding !HasJobs}"
                           Text="No jobs" />
                <ScrollViewer Grid.Row="2"
                              Classes="gutter"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Jobs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="{StaticResource SpacingSmall}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="module:PrintJobItem">
                                <Grid RowDefinitions="Auto,Auto"
                                      ColumnDefinitions="*,Auto"
                                      ColumnSpacing="{StaticResource SpacingSmall}">
                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="{StaticResource FontSizeLarge}">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}#{0}  {1}">
                                                <Binding Path="JobId" />
                                                <Binding Path="Title" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <Border Grid.Row="0" Grid.Column="1"
                                            Classes="state-chip"
                                            HorizontalAlignment="Right"
                                            Background="{Binding State, Converter={StaticResource JobStateBrushConverter}}">
                                        <TextBlock Text="{Binding State}"
                                                   FontSize="{StaticResource FontSizeNormal}" />
                                    </Border>
                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                               Classes="card-meta"
                                               VerticalAlignment="Center"
                                               Text="{Binding SubmitTime, StringFormat='{}{0:yyyy/MM/dd HH:mm:ss}'}" />
                                    <Button Grid.Row="1" Grid.Column="1"
                                            Classes="panel-button"
                                            Command="{Binding $parent[ItemsControl].((module:PrinterViewModel)DataContext).CancelJobCommand, FallbackValue={x:Null}}"
                                            CommandParameter="{Binding JobId}"
                                            IsVisible="{Binding CanCancel}"
                                            Content="Cancel" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

    </Grid>

</UserControl>
