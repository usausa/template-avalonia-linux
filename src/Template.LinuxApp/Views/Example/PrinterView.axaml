<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/avalonia"
             xmlns:local="clr-namespace:Template.LinuxApp.Views.Example"
             mc:Ignorable="d"
             x:Class="Template.LinuxApp.Views.Example.PrinterView"
             x:DataType="local:PrinterViewModel"
             s:DataContextResolver.Type="local:PrinterViewModel"
             d:DesignWidth="1280" d:DesignHeight="740">

    <StackPanel Orientation="Horizontal"
                Margin="{StaticResource PaddingLarge}"
                Spacing="{StaticResource SpacingSmall}">
        <Button Width="240"
                Command="{Binding PrintTextCommand}"
                Content="Text"
                Classes="command" />
        <Button Width="240"
                Command="{Binding PrintImageCommand}"
                Content="Image"
                Classes="command" />
    </StackPanel>

</UserControl>
