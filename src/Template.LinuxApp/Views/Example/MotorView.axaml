<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/avalonia"
             xmlns:local="clr-namespace:Template.LinuxApp.Views.Example"
             mc:Ignorable="d"
             x:Class="Template.LinuxApp.Views.Example.MotorView"
             x:DataType="local:MotorViewModel"
             s:DataContextResolver.Type="local:MotorViewModel"
             d:DesignWidth="1280" d:DesignHeight="696">

    <UserControl.Styles>
        <Style Selector="Button.angle">
            <Setter Property="MinWidth" Value="64" />
        </Style>
        <Style Selector="Grid.slider-row">
            <Setter Property="ColumnSpacing" Value="{StaticResource SpacingSmall}" />
        </Style>
        <Style Selector="Grid.slider-row > TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.pose">
            <Setter Property="Padding" Value="{StaticResource PaddingNormal}" />
            <Setter Property="BorderThickness" Value="{StaticResource BorderThicknessNormal}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
        </Style>
        <Style Selector="Border.pose.selected">
            <Setter Property="BorderBrush" Value="{StaticResource ChartBlue}" />
        </Style>
        <Style Selector="Border.chip">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="BorderThickness" Value="{StaticResource BorderThicknessThin}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelNoteBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*,*"
          ColumnDefinitions="*,*"
          Margin="{StaticResource PaddingSmall}"
          ColumnSpacing="{StaticResource SpacingSmall}"
          RowSpacing="{StaticResource SpacingSmall}">

        <Border Grid.Row="0" Grid.Column="0"
                Classes="panel">
            <StackPanel Spacing="{StaticResource SpacingSmall}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Servo"
                               Classes="panel-title" />
                    <CheckBox Grid.Column="1"
                              Content="Gamepad control (LX to servo 1, RY to servo 2)"
                              IsChecked="{Binding IsGamepadControl}" />
                </Grid>

                <Grid ColumnDefinitions="80,*,56,Auto"
                      Classes="slider-row">
                    <TextBlock Text="Servo 1"
                               Classes="panel-text" />
                    <Slider Grid.Column="1"
                            Minimum="{Binding Servo1Minimum}" Maximum="{Binding Servo1Maximum}"
                            IsSnapToTickEnabled="True" TickFrequency="1"
                            Value="{Binding Servo1}" />
                    <TextBlock Grid.Column="2"
                               HorizontalAlignment="Right"
                               Text="{Binding Servo1, StringFormat={}{0}°}"
                               Classes="panel-value" />
                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                Spacing="{StaticResource SpacingXSmall}">
                        <Button Command="{Binding ServoPresetCommand}"
                                CommandParameter="1,0"
                                Content="0°"
                                Classes="panel-button angle" />
                        <Button Command="{Binding ServoPresetCommand}"
                                CommandParameter="1,90"
                                Content="90°"
                                Classes="panel-button angle" />
                        <Button Command="{Binding ServoPresetCommand}"
                                CommandParameter="1,180"
                                Content="180°"
                                Classes="panel-button angle" />
                    </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="80,*,56,Auto"
                      Classes="slider-row">
                    <TextBlock Text="Servo 2"
                               Classes="panel-text" />
                    <Slider Grid.Column="1"
                            Minimum="{Binding Servo2Minimum}" Maximum="{Binding Servo2Maximum}"
                            IsSnapToTickEnabled="True" TickFrequency="1"
                            Value="{Binding Servo2}" />
                    <TextBlock Grid.Column="2"
                               HorizontalAlignment="Right"
                               Text="{Binding Servo2, StringFormat={}{0}°}"
                               Classes="panel-value" />
                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                Spacing="{StaticResource SpacingXSmall}">
                        <Button Command="{Binding ServoPresetCommand}"
                                CommandParameter="2,0"
                                Content="0°"
                                Classes="panel-button angle" />
                        <Button Command="{Binding ServoPresetCommand}"
                                CommandParameter="2,90"
                                Content="90°"
                                Classes="panel-button angle" />
                        <Button Command="{Binding ServoPresetCommand}"
                                CommandParameter="2,180"
                                Content="180°"
                                Classes="panel-button angle" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Calibration"
                           Classes="panel-header" />
                <Grid ColumnDefinitions="80,*,56,80,*,56"
                      RowDefinitions="Auto,Auto"
                      Classes="slider-row">
                    <TextBlock Text="1 min"
                               Classes="panel-name" />
                    <Slider Grid.Row="0" Grid.Column="1"
                            Minimum="0" Maximum="90"
                            IsSnapToTickEnabled="True" TickFrequency="1"
                            Value="{Binding Servo1Minimum}" />
                    <TextBlock Grid.Row="0" Grid.Column="2"
                               HorizontalAlignment="Right"
                               Text="{Binding Servo1Minimum, StringFormat={}{0}°}"
                               Classes="panel-text" />
                    <TextBlock Grid.Row="0" Grid.Column="3"
                               Text="1 max"
                               Classes="panel-name" />
                    <Slider Grid.Row="0" Grid.Column="4"
                            Minimum="90" Maximum="180"
                            IsSnapToTickEnabled="True" TickFrequency="1"
                            Value="{Binding Servo1Maximum}" />
                    <TextBlock Grid.Row="0" Grid.Column="5"
                               HorizontalAlignment="Right"
                               Text="{Binding Servo1Maximum, StringFormat={}{0}°}"
                               Classes="panel-text" />
                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="2 min"
                               Classes="panel-name" />
                    <Slider Grid.Row="1" Grid.Column="1"
                            Minimum="0" Maximum="90"
                            IsSnapToTickEnabled="True" TickFrequency="1"
                            Value="{Binding Servo2Minimum}" />
                    <TextBlock Grid.Row="1" Grid.Column="2"
                               HorizontalAlignment="Right"
                               Text="{Binding Servo2Minimum, StringFormat={}{0}°}"
                               Classes="panel-text" />
                    <TextBlock Grid.Row="1" Grid.Column="3"
                               Text="2 max"
                               Classes="panel-name" />
                    <Slider Grid.Row="1" Grid.Column="4"
                            Minimum="90" Maximum="180"
                            IsSnapToTickEnabled="True" TickFrequency="1"
                            Value="{Binding Servo2Maximum}" />
                    <TextBlock Grid.Row="1" Grid.Column="5"
                               HorizontalAlignment="Right"
                               Text="{Binding Servo2Maximum, StringFormat={}{0}°}"
                               Classes="panel-text" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="0" Grid.Column="1"
                Classes="panel">
            <StackPanel Spacing="{StaticResource SpacingSmall}">
                <TextBlock Text="LED"
                           Classes="panel-title" />
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="{StaticResource SpacingMedium}">
                    <Border Width="120" Height="120"
                            BorderThickness="{StaticResource BorderThicknessThin}"
                            BorderBrush="{DynamicResource PanelNoteBrush}">
                        <Border.Background>
                            <SolidColorBrush Color="{Binding LedColor}" />
                        </Border.Background>
                    </Border>
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="{StaticResource SpacingXSmall}">
                        <Grid ColumnDefinitions="24,*,48"
                              Classes="slider-row">
                            <TextBlock Text="R"
                                       Classes="panel-text" />
                            <Slider Grid.Column="1"
                                    Minimum="0" Maximum="255"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    Value="{Binding Red}" />
                            <TextBlock Grid.Column="2"
                                       HorizontalAlignment="Right"
                                       Text="{Binding Red}"
                                       Classes="panel-text" />
                        </Grid>
                        <Grid ColumnDefinitions="24,*,48"
                              Classes="slider-row">
                            <TextBlock Text="G"
                                       Classes="panel-text" />
                            <Slider Grid.Column="1"
                                    Minimum="0" Maximum="255"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    Value="{Binding Green}" />
                            <TextBlock Grid.Column="2"
                                       HorizontalAlignment="Right"
                                       Text="{Binding Green}"
                                       Classes="panel-text" />
                        </Grid>
                        <Grid ColumnDefinitions="24,*,48"
                              Classes="slider-row">
                            <TextBlock Text="B"
                                       Classes="panel-text" />
                            <Slider Grid.Column="1"
                                    Minimum="0" Maximum="255"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    Value="{Binding Blue}" />
                            <TextBlock Grid.Column="2"
                                       HorizontalAlignment="Right"
                                       Text="{Binding Blue}"
                                       Classes="panel-text" />
                        </Grid>
                    </StackPanel>
                </Grid>
                <ItemsControl ItemsSource="{Binding LedPresets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="5"
                                         ColumnSpacing="{StaticResource SpacingSmall}"
                                         RowSpacing="{StaticResource SpacingSmall}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:LedPreset">
                            <Button HorizontalAlignment="Stretch"
                                    Command="{Binding $parent[ItemsControl].((local:MotorViewModel)DataContext).LedPresetCommand, FallbackValue={x:Null}}"
                                    CommandParameter="{Binding}"
                                    Classes="panel-button">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="{StaticResource SpacingSmall}">
                                    <Border Classes="chip">
                                        <Border.Background>
                                            <SolidColorBrush Color="{Binding Color}" />
                                        </Border.Background>
                                    </Border>
                                    <TextBlock VerticalAlignment="Center"
                                               Text="{Binding Name}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="0"
                Classes="panel">
            <StackPanel Spacing="{StaticResource SpacingSmall}">
                <TextBlock Text="Sequence"
                           Classes="panel-title" />
                <ItemsControl ItemsSource="{Binding Poses}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4"
                                         ColumnSpacing="{StaticResource SpacingSmall}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:MotorPoseItem">
                            <Button HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding $parent[ItemsControl].((local:MotorViewModel)DataContext).SelectPoseCommand, FallbackValue={x:Null}}"
                                    CommandParameter="{Binding}">
                                <Border Classes="pose"
                                        Classes.selected="{Binding IsSelected}">
                                    <StackPanel Spacing="{StaticResource SpacingXSmall}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding Name}"
                                                       Classes="panel-text" />
                                            <Border Grid.Column="1"
                                                    Classes="chip">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{Binding Color}" />
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                        <TextBlock Classes="panel-name">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0}° / {1}°">
                                                    <Binding Path="Servo1" />
                                                    <Binding Path="Servo2" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal"
                            Spacing="{StaticResource SpacingSmall}">
                    <Button Command="{Binding SavePoseCommand}"
                            Content="Save to selected"
                            Classes="panel-button" />
                    <Button Command="{Binding PlayCommand}"
                            Content="Play"
                            Classes="panel-button" />
                    <Button Command="{Binding StopCommand}"
                            Content="Stop"
                            Classes="panel-button" />
                </StackPanel>
                <Grid ColumnDefinitions="80,*,56"
                      Classes="slider-row">
                    <TextBlock Text="Interval"
                               Classes="panel-text" />
                    <Slider Grid.Column="1"
                            Minimum="0.2" Maximum="3"
                            IsSnapToTickEnabled="True" TickFrequency="0.1"
                            Value="{Binding Interval}" />
                    <TextBlock Grid.Column="2"
                               HorizontalAlignment="Right"
                               Text="{Binding Interval, StringFormat={}{0:0.0} s}"
                               Classes="panel-text" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="1"
                Classes="panel">
            <DockPanel>
                <Grid DockPanel.Dock="Top"
                      Margin="0,0,0,6"
                      ColumnDefinitions="*,Auto">
                    <TextBlock Text="Log"
                               Classes="panel-title" />
                    <TextBlock Grid.Column="1"
                               Classes="panel-name">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0}  {1}  {2}">
                                <Binding Path="Status.Condition" FallbackValue="" />
                                <Binding Path="Port" />
                                <Binding Path="Status.LastError" FallbackValue="" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Grid>
                <ItemsControl ItemsSource="{Binding Logs}"
                              ClipToBounds="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}"
                                       Classes="panel-text" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>
    </Grid>

</UserControl>
