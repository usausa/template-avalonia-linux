<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Template.LinuxApp.Views.Dialogs.PinDialog">

    <Border Classes="dialog">
        <StackPanel>
            <TextBlock x:Name="TitleText"
                       Classes="dialog-title" />
            <TextBlock x:Name="ValueText"
                       MinHeight="44"
                       HorizontalAlignment="Center"
                       FontSize="32" />
            <StackPanel HorizontalAlignment="Center">
                <UniformGrid Columns="3">
                    <Button Classes="keypad"
                            Content="1"
                            Click="OnDigitClick" />
                    <Button Classes="keypad"
                            Content="2"
                            Click="OnDigitClick" />
                    <Button Classes="keypad"
                            Content="3"
                            Click="OnDigitClick" />
                    <Button Classes="keypad"
                            Content="4"
                            Click="OnDigitClick" />
                    <Button Classes="keypad"
                            Content="5"
                            Click="OnDigitClick" />
                    <Button Classes="keypad"
                            Content="6"
                            Click="OnDigitClick" />
                    <Button Classes="keypad"
                            Content="7"
                            Click="OnDigitClick" />
                    <Button Classes="keypad"
                            Content="8"
                            Click="OnDigitClick" />
                    <Button Classes="keypad"
                            Content="9"
                            Click="OnDigitClick" />
                    <Button Classes="keypad"
                            Content="Del"
                            Click="OnDeleteClick" />
                    <Button Classes="keypad"
                            Content="0"
                            Click="OnDigitClick" />
                    <Button Classes="keypad"
                            IsDefault="True"
                            Content="OK"
                            Click="OnOkClick" />
                </UniformGrid>
                <Button Margin="4,8,4,4"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        IsCancel="True"
                        Content="Cancel"
                        Click="OnCancelClick" />
            </StackPanel>
        </StackPanel>
    </Border>

</UserControl>
