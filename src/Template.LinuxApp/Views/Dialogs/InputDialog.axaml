<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Template.LinuxApp.Views.Dialogs.InputDialog">

    <Border Classes="dialog">
        <StackPanel>
            <TextBlock x:Name="TitleText"
                       Classes="dialog-title" />
            <TextBox x:Name="ValueText" />
            <StackPanel Orientation="Horizontal"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Right"
                        Spacing="8">
                <Button Width="96"
                        Content="OK"
                        Click="OnOkClick" IsDefault="True" />
                <Button Width="96"
                        Content="Cancel"
                        Click="OnCancelClick" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </Border>

</UserControl>
