<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Template.LinuxApp.Views.Dialogs.ConfirmDialog">

    <Border Classes="dialog">
        <StackPanel>
            <TextBlock Classes="dialog-title"
                       Text="Confirm" />
            <TextBlock x:Name="MessageText"
                       TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal"
                        Margin="0,16,0,0"
                        Spacing="8"
                        HorizontalAlignment="Right">
                <Button Width="96"
                        IsDefault="True"
                        Content="Yes"
                        Click="OnYesClick" />
                <Button Width="96"
                        IsCancel="True"
                        Content="No"
                        Click="OnNoClick" />
            </StackPanel>
        </StackPanel>
    </Border>

</UserControl>
