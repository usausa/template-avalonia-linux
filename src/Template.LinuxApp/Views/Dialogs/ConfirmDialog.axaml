<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Template.LinuxApp.Views.Dialogs.ConfirmDialog">

    <Border Classes="dialog">
        <StackPanel>
            <TextBlock Text="Confirm"
                       Classes="dialog-title" />
            <TextBlock x:Name="MessageText"
                       TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Right"
                        Spacing="8">
                <Button Width="96"
                        Content="Yes"
                        Click="OnYesClick" IsDefault="True" />
                <Button Width="96"
                        Content="No"
                        Click="OnNoClick" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </Border>

</UserControl>
