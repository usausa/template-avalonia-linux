<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/avalonia"
             xmlns:local="clr-namespace:Template.LinuxApp.Views.Main"
             mc:Ignorable="d"
             x:Class="Template.LinuxApp.Views.Main.SubView"
             x:DataType="local:SubViewModel"
             s:DataContextResolver.Type="local:SubViewModel"
             d:DesignWidth="800" d:DesignHeight="450">

    <StackPanel Margin="16"
                Spacing="16">
        <Label Content="{Binding Message}" />
        <Label Content="{Binding Result}" />
        <StackPanel Orientation="Horizontal"
                    Spacing="8">
            <Button Width="96"
                    Command="{Binding ConfirmCommand}"
                    Content="Confirm" />
            <Button Width="96"
                    Command="{Binding InputCommand}"
                    Content="Input" />
            <Button Width="96"
                    Command="{Binding NavigateCommand}"
                    Content="Back" />
        </StackPanel>
    </StackPanel>

</UserControl>
